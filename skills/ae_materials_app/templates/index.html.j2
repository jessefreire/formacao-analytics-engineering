<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Formação AE — Materiais</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/motion@latest/dist/motion.min.js"></script>
<style>
:root {
  --bg: #ffffff; --fg: #1a1a2e; --muted: #6b6b80;
  --border: #e0e0e8; --card: #fafafa; --code-bg: #f4f4f8;
  --accent: #2d2d44; --accent-hover: #1a1a2e;
  --sidebar-w: 280px;
  --shadow-sm: 0 1px 2px rgba(0,0,0,0.04);
  --shadow-md: 0 4px 12px rgba(0,0,0,0.08);
  --shadow-lg: 0 12px 24px rgba(0,0,0,0.12);
  --radius-sm: 6px; --radius-md: 10px; --radius-lg: 14px;
  --response: 0.35s; --damping: 1.0;
}
[data-theme="dark"] {
  --bg: #0f0f1a; --fg: #e8e8f0; --muted: #8b8ba8;
  --border: #2a2a40; --card: #161624; --code-bg: #1e1e30;
  --accent: #c8c8e0; --accent-hover: #ffffff;
  --shadow-sm: 0 1px 2px rgba(0,0,0,0.2);
  --shadow-md: 0 4px 12px rgba(0,0,0,0.3);
  --shadow-lg: 0 12px 24px rgba(0,0,0,0.4);
}
@media (prefers-reduced-motion: reduce) {
  :root { --response: 0.01s; --damping: 1.0; }
  *, *::before, *::after {
    animation-duration: 0.01s !important;
    transition-duration: 0.01s !important;
  }
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; }
body {
  font-family: 'IBM Plex Sans', system-ui, -apple-system, sans-serif;
  background: var(--bg); color: var(--fg);
  line-height: 1.6; font-size: 16px;
  display: flex;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}
:root { font: 100%/1.5 system-ui, sans-serif; }

/* ========== ANIMATIONS ========== */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: none; }
}

/* ========== SPRING ANIMATION HELPERS ========== */
.spring-enter { opacity: 0; transform: translateY(8px); }
.spring-enter-active { opacity: 1; transform: none; }
.spring-exit { opacity: 1; transform: none; }
.spring-exit-active { opacity: 0; transform: translateY(-4px); }

/* ========== SIDEBAR ========== */
.sidebar {
  width: var(--sidebar-w); min-width: var(--sidebar-w); max-width: var(--sidebar-w);
  border-right: 1px solid var(--border);
  background: rgba(var(--card-rgb, 250,250,250), 0.8);
  backdrop-filter: blur(20px) saturate(180%);
  border-top: 1px solid rgba(255,255,255,0.4);
  display: flex; flex-direction: column;
  height: 100vh;
  position: relative;
  box-shadow: var(--shadow-md);
  z-index: 10;
  transition: width var(--response) cubic-bezier(0.25,0.46,0.45,0.94), opacity var(--response);
}
[data-theme="dark"] .sidebar {
  background: rgba(var(--card-rgb, 22,22,36), 0.85);
  border-top: 1px solid rgba(255,255,255,0.1);
}
.sidebar-header {
  padding: 1rem; border-bottom: 1px solid var(--border);
  display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
}
.sidebar-title { font-weight: 600; font-size: 0.8125rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
.theme-toggle {
  background: var(--code-bg); border: 1px solid var(--border);
  color: var(--fg); width: 32px; height: 32px; padding: 0;
  border-radius: var(--radius-sm); cursor: pointer; font-size: 0.875rem;
  font-family: inherit; display: flex; align-items: center; justify-content: center;
  transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
}
.theme-toggle:active { transform: scale(0.94); }
.theme-toggle:hover { background: var(--border); }
.theme-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

.nav { padding: 0.5rem; flex: 1; overflow-y: auto; }
.nav-section { margin-bottom: 1rem; }
.nav-label { font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 0.375rem; padding: 0 0.5rem; }
.nav-link {
  display: block; padding: 0.5625rem 0.75rem; border-radius: var(--radius-md);
  color: var(--fg); text-decoration: none; font-size: 0.875rem;
  transition: background 0.12s ease, color 0.12s ease, transform 0.1s ease;
}
.nav-link:active { transform: scale(0.98); }
.nav-link:hover { background: var(--code-bg); }
.nav-link.active { background: var(--accent); color: var(--bg); font-weight: 500; }
.nav-link::before { content: "\2022 "; color: var(--muted); transition: color 0.12s ease; }
.nav-link.active::before { content: "\25B8 "; color: inherit; }

.sidebar-actions { display: flex; align-items: center; gap: 0.375rem; }
.sidebar-toggle {
  background: var(--code-bg); border: 1px solid var(--border);
  color: var(--fg); width: 32px; height: 32px; padding: 0;
  border-radius: var(--radius-sm); cursor: pointer; font-size: 0.875rem;
  font-family: inherit; display: flex; align-items: center; justify-content: center;
  transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
}
.sidebar-toggle:hover { background: var(--border); }
.sidebar-toggle:active { transform: scale(0.92); }
.sidebar-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

/* ========== COLLAPSED / REDUCED MODE ========== */
[data-sidebar-collapsed="true"] .sidebar {
  width: 64px !important; min-width: 64px !important; max-width: 64px !important;
}
[data-sidebar-collapsed="true"] .sidebar-header { flex-direction: column; justify-content: flex-start; padding: 0.75rem 0.25rem; gap: 0.5rem; }
[data-sidebar-collapsed="true"] .sidebar-actions { flex-direction: column; }
[data-sidebar-collapsed="true"] .sidebar-title { display: none; }
[data-sidebar-collapsed="true"] .resize-handle { width: 12px; background: transparent; }
[data-sidebar-collapsed="true"] .nav { padding: 0.25rem; }
[data-sidebar-collapsed="true"] .nav-section { display: none; }
[data-sidebar-collapsed="true"] .nav-chip {
  display: flex; align-items: center; justify-content: center;
  width: 100%; padding: 0.5rem 0; margin-bottom: 0.375rem;
  background: transparent; border: 1px solid var(--border); border-radius: var(--radius-md);
  color: var(--fg); cursor: pointer; font-family: inherit;
  transition: background 0.15s ease, transform 0.15s ease;
}
[data-sidebar-collapsed="true"] .nav-chip:hover { background: var(--border); }
[data-sidebar-collapsed="true"] .nav-chip:active { transform: scale(0.94); }
[data-sidebar-collapsed="true"] .chip-key { font-size: 0.75rem; font-weight: 600; }

/* ========== MOBILE ========== */

.resize-handle {
  position: absolute; top: 0; right: 0; bottom: 0; width: 4px;
  cursor: col-resize; background: transparent; z-index: 40;
  touch-action: none;
  transition: background 0.15s ease;
}
.resize-handle::before {
  content: ''; position: absolute; top: 0; bottom: 0; left: -6px; width: 10px;
}
.resize-handle:hover, .resize-handle.dragging { background: var(--accent); }

/* ========== MAIN ========== */
.main { flex: 1; overflow-y: auto; padding: clamp(1.5rem, 3vw, 3rem); padding-bottom: 6rem; }
.main-header { margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border); }
.main-header-empty { display: flex; align-items: center; gap: 0.5rem; min-height: 2.5rem; }
.main-header-empty .empty-hint { color: var(--muted); font-size: 0.875rem; }

.main-title {
  font-size: clamp(1.5rem, 3vw, 2.25rem);
  font-weight: 600; line-height: 1.15;
  letter-spacing: -0.02em;
}
.main-meta { color: var(--muted); font-size: 0.8125rem; margin-top: 0.5rem; }

/* ========== FILE NAV (floating) ========== */
.file-nav {
  position: fixed; right: 0; bottom: 0; z-index: 39;
  left: var(--sidebar-w);
  display: flex; gap: 0.75rem; align-items: stretch;
  padding: 0.75rem 1.5rem;
  background: rgba(var(--card-rgb, 250,250,250), 0.85);
  backdrop-filter: blur(20px) saturate(180%);
  border-top: 1px solid var(--border);
  transition: left var(--response) cubic-bezier(0.25,0.46,0.45,0.94);
}
[data-sidebar-collapsed="true"] .file-nav { left: 64px; }
[data-theme="dark"] .file-nav {
  background: rgba(var(--card-rgb, 22,22,36), 0.85);
}
.file-nav-btn {
  flex: 1 1 0; min-width: 0; display: flex; align-items: center; gap: 0.75rem;
  padding: 0.75rem 1.25rem; border: 1px solid var(--border); border-radius: var(--radius-md);
  background: var(--code-bg); color: var(--fg); cursor: pointer; font-family: inherit;
  text-align: left;
  transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
}
.file-nav-btn.next { flex-direction: row-reverse; text-align: right; }
.file-nav-btn:hover:not(:disabled) { background: var(--border); border-color: var(--accent); }
.file-nav-btn:active { transform: scale(0.98); }
.file-nav-btn:disabled { display: none; }
.file-nav-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.fn-arrow { font-size: 1.25rem; line-height: 1; color: var(--accent); flex-shrink: 0; }
.fn-meta { display: flex; flex-direction: column; gap: 0.125rem; min-width: 0; flex: 1; }
.file-nav-btn.next .fn-meta { align-items: flex-end; }
.fn-caption { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
.fn-title { font-size: 0.8125rem; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ========== CONTENT ========== */
.content { width: 100%; max-width: 100%; }
.content h1 { font-size: clamp(1.375rem, 2.5vw, 1.75rem); font-weight: 600; line-height: 1.2; margin: 2.5rem 0 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border); letter-spacing: -0.01em; }
.content h2 { font-size: clamp(1.125rem, 2vw, 1.375rem); font-weight: 600; line-height: 1.3; margin: 2rem 0 0.75rem; letter-spacing: -0.005em; }
.content h3 { font-size: 1rem; font-weight: 600; line-height: 1.4; margin: 1.75rem 0 0.5rem; color: var(--muted); }
.content p { margin: 0.875rem 0; text-wrap: pretty; }
.content ul, .content ol { margin: 0.875rem 0 0.875rem 1.5rem; }
.content li { margin: 0.375rem 0; }
.content code { font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 0.85em; background: var(--code-bg); padding: 0.125rem 0.375rem; border-radius: 4px; }
.content pre { background: var(--code-bg); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1rem; overflow-x: auto; margin: 1.25rem 0; box-shadow: var(--shadow-sm); }
.content pre code { background: none; padding: 0; font-size: 0.8125rem; line-height: 1.6; }
.content blockquote { border-left: 3px solid var(--accent); padding-left: 1rem; margin: 1.25rem 0; color: var(--muted); font-style: italic; }
.content table { width: 100%; border-collapse: collapse; margin: 1.25rem 0; font-size: 0.875rem; }
.content th, .content td { border: 1px solid var(--border); padding: 0.625rem 0.875rem; text-align: left; }
.content th { background: var(--code-bg); font-weight: 600; }
.content tr:nth-child(even) td { background: var(--card); }
.content hr { border: none; border-top: 1px solid var(--border); margin: 2.5rem 0; }
.content strong { font-weight: 600; }
.content a { color: var(--accent); text-decoration: none; border-bottom: 1px solid transparent; transition: border-color 0.1s ease, color 0.1s ease; }
.content a:hover { border-bottom-color: var(--accent); }

.module-badge {
  display: inline-block; font-size: 0.6875rem; font-weight: 600;
  text-transform: uppercase; letter-spacing: 0.06em;
  padding: 0.1875rem 0.625rem; border-radius: 999px;
  background: var(--code-bg); color: var(--muted); margin-bottom: 1rem;
  transition: background 0.12s ease, color 0.12s ease, transform 0.1s ease;
}
.module-badge:active { transform: scale(0.95); }
/* ========== MOBILE ========== */
@media (max-width: 900px) {
  .sidebar-toggle { display: none; }
  .sidebar { position: fixed; left: 0; top: 0; bottom: 0; z-index: 100; transform: translateX(-100%); transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94); box-shadow: var(--shadow-lg); }
  .sidebar.open { transform: none !important; }
  .main { padding: 1.5rem; padding-bottom: 9rem; }
  .mobile-toggle { display: block; position: fixed; bottom: 5.5rem; right: 1.25rem; z-index: 50; background: var(--accent); color: var(--bg); border: none; padding: 0.75rem 1.125rem; border-radius: var(--radius-md); font-weight: 500; font-size: 0.875rem; cursor: pointer; box-shadow: var(--shadow-lg); transition: transform 0.15s ease, box-shadow 0.15s ease; }
  .mobile-toggle:active { transform: scale(0.95); box-shadow: var(--shadow-md); }
  .mobile-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .file-nav { flex-direction: row; }
  .file-nav .fn-title { display: none; }
  .file-nav-btn { max-width: none; padding: 0.625rem; }
  .fn-arrow { font-size: 1rem; }
}
@media (min-width: 901px) { .mobile-toggle { display: none; } }

/* ========== MARKDOWN BODY SPACING ========== */
.markdown-body { line-height: 1.7; }
.markdown-body > * + * { margin-top: 0.75rem; }
.markdown-body h1 { margin-top: 0; }
.markdown-body table { font-size: 0.85rem; }

/* ========== FOCUS VISIBLE ========== */
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

/* ========== VERSION FOOTER + UPDATE BANNER ========== */
.sidebar-footer { display: flex; flex-direction: column; align-items: stretch; gap: 4px; padding: 8px 10px; border-top: 1px solid var(--border, #e0e0e0); font-size: 0.7rem; }
.version-badge { font-family: monospace; font-size: 0.68rem; background: var(--accent-soft, #e8f0f2); color: var(--accent, #0F7E8C); padding: 2px 6px; border-radius: 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: center; }
.version-check { font-size: 0.75rem; padding: 2px 10px; border-radius: 10px; border: 1px solid var(--border, #e0e0e0); background: transparent; cursor: pointer; }
.version-check:hover { background: var(--accent-soft, #e8f0f2); }
.version-check:disabled { opacity: 0.5; cursor: wait; }
.update-banner { display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: #fff8e1; border-top: 1px solid #ffe082; font-size: 0.78rem; }
.update-banner[hidden] { display: none; }
.update-banner a { color: #0F7E8C; font-weight: 600; }
.update-banner button { margin-left: auto; background: none; border: none; font-size: 1.1rem; cursor: pointer; }
</style>
</head>
<body>
<div class="sidebar" id="sidebar">
  <header class="sidebar-header">
    <span class="sidebar-title">Formação AE</span>
    <div class="sidebar-actions">
      <button class="sidebar-toggle" id="sidebarToggle" aria-label="Recolher painel" title="Recolher painel (Ctrl+B)" aria-expanded="true">⟨</button>
      <button class="theme-toggle" id="themeToggle" aria-label="Alternar tema" aria-pressed="false">☀️/🌙</button>
    </div>
  </header>
  <nav class="nav" id="nav" role="navigation" aria-label="Materiais do curso"></nav>
  <div class="sidebar-footer" id="versionFooter">
    <span class="version-badge" id="versionBadge" title="Versao local">v...</span>
    <button class="version-check" id="checkUpdates" title="Verificar atualizacoes no GitHub">Verificar</button>
  </div>
  <div class="update-banner" id="updateBanner" hidden>
    <span id="updateText"></span>
    <a id="updateLink" href="#" target="_blank" rel="noopener">Ver diff</a>
    <button id="updateDismiss" aria-label="Fechar aviso">&times;</button>
  </div>
  <div class="resize-handle" id="resizeHandle"></div>
</div>
<main class="main" id="main" role="main">
  <div class="main-header-empty" id="emptyHint"><span class="empty-hint">Selecione um material ⟶</span></div>
  <article class="content" id="content" hidden></article>
  <nav class="file-nav" id="fileNav" aria-label="Navegação entre materiais" hidden>
    <button class="file-nav-btn" id="prevBtn">
      <span class="fn-arrow">‹</span>
      <span class="fn-meta"><span class="fn-caption">Anterior</span><span class="fn-title" id="prevTitle"></span></span>
    </button>
    <button class="file-nav-btn next" id="nextBtn">
      <span class="fn-meta"><span class="fn-caption">Próximo</span><span class="fn-title" id="nextTitle"></span></span>
      <span class="fn-arrow">›</span>
    </button>
  </nav>
</main>
<button class="mobile-toggle" id="mobileToggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="sidebar">☰ Menu</button>
<script>
// ========== FILES AUTO-GENERATED ==========
const FILES = [
  // INJETADO AUTOMATICAMENTE POR ae-materials-app
];
// ========== END FILES ==========

// ========== APP STATE ==========
let currentFile = null;
let sidebarOpen = false;
let isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
const MIN_SIDEBAR = 200;
const MAX_SIDEBAR = 600;
const COLLAPSE_W = 64;

// ========== THEME ==========
function initTheme() {
  const saved = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  document.documentElement.setAttribute('data-theme', saved);
  updateThemeIcon(saved);
}
function toggleTheme() {
  const current = document.documentElement.getAttribute('data-theme');
  const next = current === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', next);
  localStorage.setItem('theme', next);
  updateThemeIcon(next);
}

// ========== SIDEBAR COLLAPSE ==========
function updateSidebarToggleBtn() {
  const btn = document.getElementById('sidebarToggle');
  if (isCollapsed) {
    btn.textContent = '⟩';
    btn.setAttribute('aria-label', 'Expandir painel');
    btn.setAttribute('title', 'Expandir painel (Ctrl+B)');
  } else {
    btn.textContent = '⟨';
    btn.setAttribute('aria-label', 'Recolher painel');
    btn.setAttribute('title', 'Recolher painel (Ctrl+B)');
  }
}
function toggleSidebarCollapse() {
  isCollapsed = !isCollapsed;
  document.documentElement.setAttribute('data-sidebar-collapsed', isCollapsed);
  localStorage.setItem('sidebarCollapsed', isCollapsed);
  updateSidebarToggleBtn();
  renderNav();
}

// ========== SIDEBAR RESIZE ==========
function initResizeHandle() {
  const handle = document.getElementById('resizeHandle');
  let startX = 0;
  let startW = 0;
  let pointerId = null;

  function onPointerMove(e) {
    const delta = e.clientX - startX;
    let newW = startW + delta;

    if (isCollapsed) {
      if (newW > COLLAPSE_W + 24) {
        isCollapsed = false;
        document.documentElement.setAttribute('data-sidebar-collapsed', 'false');
        updateSidebarToggleBtn();
        renderNav();
      } else {
        return;
      }
    } else if (newW < COLLAPSE_W + 24) {
      isCollapsed = true;
      document.documentElement.setAttribute('data-sidebar-collapsed', 'true');
      updateSidebarToggleBtn();
      renderNav();
      return;
    }

    newW = Math.max(MIN_SIDEBAR, Math.min(MAX_SIDEBAR, newW));
    document.documentElement.style.setProperty('--sidebar-w', newW + 'px');
  }
  function onPointerUp() {
    document.removeEventListener('pointermove', onPointerMove);
    document.removeEventListener('pointerup', onPointerUp);
    handle.classList.remove('dragging');
    document.body.style.cursor = '';
    document.body.style.userSelect = '';

    if (isCollapsed) {
      localStorage.setItem('sidebarCollapsed', 'true');
      return;
    }
    const currentW = document.documentElement.style.getPropertyValue('--sidebar-w');
    localStorage.setItem('sidebarWidth', currentW);
    if (handle.hasPointerCapture(pointerId)) handle.releasePointerCapture(pointerId);
  }
  handle.addEventListener('pointerdown', (e) => {
    e.preventDefault();
    pointerId = e.pointerId;
    startX = e.clientX;
    const style = getComputedStyle(document.documentElement);
    startW = parseFloat(style.getPropertyValue('--sidebar-w')) || 280;
    handle.classList.add('dragging');
    handle.setPointerCapture(e.pointerId);
    document.body.style.cursor = 'col-resize';
    document.body.style.userSelect = 'none';
    document.addEventListener('pointermove', onPointerMove);
    document.addEventListener('pointerup', onPointerUp);
  });
}

// ========== RESTORE SIDEBAR STATE ==========
function initSidebarState() {
  const savedW = localStorage.getItem('sidebarWidth');
  if (savedW) {
    document.documentElement.style.setProperty('--sidebar-w', savedW);
  }
  document.documentElement.setAttribute('data-sidebar-collapsed', isCollapsed);
  updateSidebarToggleBtn();
}
function updateThemeIcon(theme) {
  const btn = document.getElementById('themeToggle');
  btn.textContent = theme === 'dark' ? '☀️' : '🌙';
  btn.setAttribute('aria-pressed', theme === 'dark');
}

// ========== SIDEBAR MOBILE ==========
function toggleSidebar(open) {
  sidebarOpen = open;
  const sidebar = document.getElementById('sidebar');
  const toggle = document.getElementById('mobileToggle');
  if (open) {
    sidebar.classList.add('open');
    toggle.setAttribute('aria-expanded', 'true');
  } else {
    sidebar.classList.remove('open');
    toggle.setAttribute('aria-expanded', 'false');
  }
}
function closeMobileMenu() { toggleSidebar(false); }

// ========== NAV RENDER ==========
function moduleKey(cat) {
  const m = cat.match(/M[óo]dulo\s+(\d+|IV|[IV]+)/i);
  if (m) return m[1].toUpperCase();
  if (cat === 'Config') return '\u25cf';
  return cat;
}

function renderNav() {
  const nav = document.getElementById('nav');
  const byCat = FILES.reduce((acc, f) => {
    (acc[f.cat] = acc[f.cat] || []).push(f);
    return acc;
  }, {});

  if (isCollapsed) {
    // Modo reduzido: um chip por módulo, clica para expandir e mostrar
    nav.innerHTML = Object.keys(byCat).map(cat => `
      <button class="nav-chip" data-cat="${escapeHtml(cat)}" title="${escapeHtml(cat)}">
        <span class="chip-key">${escapeHtml(moduleKey(cat))}</span>
      </button>
    `).join('');
    nav.querySelectorAll('.nav-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        const first = FILES.find(f => f.cat === chip.dataset.cat);
        if (first) loadFile(first.id);
      });
      chip.addEventListener('pointerdown', () => { chip.style.transform = 'scale(0.94)'; });
      chip.addEventListener('pointerup', () => { chip.style.transform = ''; });
      chip.addEventListener('pointerleave', () => { chip.style.transform = ''; });
    });
    return;
  }

  nav.innerHTML = Object.entries(byCat).map(([cat, files]) => `
    <section class="nav-section" aria-labelledby="cat-${cat.toLowerCase().replace(/\s+/g, '-')}">
      <h2 class="nav-label" id="cat-${cat.toLowerCase().replace(/\s+/g, '-')}">${cat}</h2>
      ${files.map(f => `
        <a class="nav-link ${f.id === currentFile ? 'active' : ''}" 
           href="#" data-id="${f.id}" title="${escapeHtml(f.title || f.label)}"
           ${f.id === currentFile ? 'aria-current="page"' : ''}>
          ${f.label}
        </a>
      `).join('')}
    </section>
  `).join('');

  nav.querySelectorAll('.nav-link').forEach(a => {
    a.addEventListener('click', e => { e.preventDefault(); loadFile(a.dataset.id); closeMobileMenu(); });
    // Instant feedback on pointer-down (Apple principle: respond on press)
    a.addEventListener('pointerdown', () => { a.style.transform = 'scale(0.98)'; });
    a.addEventListener('pointerup', () => { a.style.transform = ''; });
    a.addEventListener('pointerleave', () => { a.style.transform = ''; });
  });
}

// ========== FILE LOAD ==========
async function loadFile(id) {
  const file = FILES.find(f => f.id === id);
  if (!file) return;
  
  currentFile = id;
  renderNav();
  updateFileNav();
  showLoading();
  
  try {
    const res = await fetch(file.path, { cache: 'no-cache' });
    if (!res.ok) throw new Error(res.status + ' ' + res.statusText);
    const text = await res.text();
    renderContent(file, text);
  } catch (err) {
    renderError(file, err.message);
  }
}

// ========== FILE NAV ==========
function updateFileNav() {
  const nav = document.getElementById('fileNav');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');
  const idx = FILES.findIndex(f => f.id === currentFile);
  if (idx === -1) { nav.hidden = true; return; }

  nav.hidden = false;
  const prev = FILES[idx - 1];
  const next = FILES[idx + 1];
  document.getElementById('prevTitle').textContent = prev ? (prev.title || prev.label) : '';
  document.getElementById('nextTitle').textContent = next ? (next.title || next.label) : '';
  prevBtn.disabled = !prev;
  nextBtn.disabled = !next;
}

function showLoading() {
  const content = document.getElementById('content');
  const emptyHint = document.getElementById('emptyHint');
  emptyHint.hidden = true;
  content.hidden = false;
  content.innerHTML = '<p style="color:var(--muted);text-align:center;padding:3rem;">Carregando…</p>';
}

function renderContent(file, text) {
  const content = document.getElementById('content');
  const emptyHint = document.getElementById('emptyHint');
  emptyHint.hidden = true;
  content.hidden = false;
  
  const isMd = file.path.endsWith('.md');
  let html = isMd ? marked.parse(text) : '<pre><code>' + escapeHtml(text) + '</code></pre>';

  // O .md e injetado na pagina raiz, entao caminho relativo dentro dele
  // resolveria contra a raiz e nao contra a pasta do material. Reescreve
  // src/href relativos com o diretorio do proprio arquivo, pra imagem
  // (ex: diagrama.svg ao lado do resumo) funcionar aqui e no GitHub.
  if (isMd) {
    const dir = file.path.includes('/') ? file.path.replace(/\/[^/]*$/, '/') : '';
    if (dir) {
      const tmp = document.createElement('div');
      tmp.innerHTML = html;
      tmp.querySelectorAll('img[src], a[href]').forEach(el => {
        const attr = el.tagName === 'IMG' ? 'src' : 'href';
        const v = el.getAttribute(attr) || '';
        if (v && !/^([a-z]+:|\/|#|\?)/i.test(v)) el.setAttribute(attr, dir + v);
      });
      html = tmp.innerHTML;
    }
  }

  content.innerHTML = `
    <header class="main-header">
      <span class="module-badge">${escapeHtml(file.cat)}</span>
      <h1 class="main-title">${escapeHtml(file.title || file.label)}</h1>
      <div class="main-meta">${escapeHtml(file.path)} · ${formatBytes(text.length)}</div>
    </header>
    <div class="markdown-body">${html}</div>
  `;
  
  // Smooth scroll for internal links
  content.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', e => {
      e.preventDefault();
      const target = document.querySelector(a.getAttribute('href'));
      if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
  
  // Apply spring entrance to content
  content.style.animation = 'none';
  requestAnimationFrame(() => {
    content.style.animation = 'fadeIn 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
  });
}

function renderError(file, msg) {
  const content = document.getElementById('content');
  const emptyHint = document.getElementById('emptyHint');
  emptyHint.hidden = true;
  content.hidden = false;
  content.innerHTML = `
    <header class="main-header">
      <span class="module-badge">${escapeHtml(file.cat)}</span>
      <h1 class="main-title">${escapeHtml(file.title || file.label)}</h1>
    </header>
    <div style="color:var(--muted);padding:2rem;text-align:center;">
      <p>Erro ao carregar: <code>${escapeHtml(file.path)}</code></p>
      <p style="font-family:monospace;font-size:0.875rem;margin-top:0.5rem;">${escapeHtml(msg)}</p>
      <p style="margin-top:1rem;font-size:0.875rem;">Verifique se o servidor está rodando na pasta correta.</p>
    </div>
  `;
}

function escapeHtml(str) {
  return str
    .replace(/&/g, '&')
    .replace(/</g, '<')
    .replace(/>/g, '>')
    .replace(/"/g, '"')
    .replace(/'/g, "\\'");
}

function formatBytes(bytes) {
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1024*1024) return (bytes/1024).toFixed(1) + ' KB';
  return (bytes/1024/1024).toFixed(1) + ' MB';
}

// ========== EVENT LISTENERS ==========
document.getElementById('themeToggle').addEventListener('click', toggleTheme);
document.getElementById('sidebarToggle').addEventListener('click', toggleSidebarCollapse);
document.getElementById('mobileToggle').addEventListener('click', () => toggleSidebar(!sidebarOpen));
initResizeHandle();

function goPrev() {
  const idx = FILES.findIndex(f => f.id === currentFile);
  if (idx > 0) loadFile(FILES[idx - 1].id);
}
function goNext() {
  const idx = FILES.findIndex(f => f.id === currentFile);
  if (idx >= 0 && idx < FILES.length - 1) loadFile(FILES[idx + 1].id);
}
document.getElementById('prevBtn').addEventListener('click', goPrev);
document.getElementById('nextBtn').addEventListener('click', goNext);

// Click on main content area closes mobile menu
document.getElementById('main').addEventListener('click', () => {
  if (window.innerWidth <= 900) closeMobileMenu();
});

// Keyboard navigation
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && sidebarOpen) closeMobileMenu();
  if (e.key === 'b' && e.ctrlKey) { e.preventDefault(); toggleSidebarCollapse(); }
  if (e.key === 'ArrowLeft' && currentFile) { e.preventDefault(); goPrev(); }
  if (e.key === 'ArrowRight' && currentFile) { e.preventDefault(); goNext(); }
  if (e.key === '/' && document.activeElement.tagName !== 'INPUT') {
    e.preventDefault();
    document.getElementById('nav').querySelector('.nav-link')?.focus();
  }
});


// ==== Version + update check ====
async function initVersion() {
  let local = null;
  try {
    const r = await fetch('version.json', { cache: 'no-store' });
    if (r.ok) local = await r.json();
  } catch (e) { /* sem version.json */ }
  const badge = document.getElementById('versionBadge');
  if (local && local.short) {
    badge.textContent = 'v' + local.short + ' - ' + (local.date || '').slice(5);
    badge.title = (local.message || '') + '\n' + (local.sha || '');
    const seen = localStorage.getItem('ae_seen_version');
    if (seen && seen !== local.sha) {
      showBanner('Conteudo atualizado localmente (' + local.short + ').', null);
    }
    localStorage.setItem('ae_seen_version', local.sha || '');
    localStorage.setItem('ae_repo', local.repo || '');
  } else {
    badge.textContent = 'v?';
  }
  document.getElementById('checkUpdates').addEventListener('click', checkRemote);
  document.getElementById('updateDismiss').addEventListener('click', () => {
    document.getElementById('updateBanner').hidden = true;
  });
}
function showBanner(text, diffUrl) {
  document.getElementById('updateText').textContent = text;
  const link = document.getElementById('updateLink');
  if (diffUrl) { link.href = diffUrl; link.style.display = ''; }
  else { link.style.display = 'none'; }
  document.getElementById('updateBanner').hidden = false;
}
async function checkRemote() {
  const btn = document.getElementById('checkUpdates');
  btn.disabled = true; btn.textContent = '...';
  try {
    const repo = localStorage.getItem('ae_repo') || '';
    if (!repo) { showBanner('Repo GitHub nao configurado no version.json.', null); return; }
    const r = await fetch('https://api.github.com/repos/' + repo + '/commits?per_page=1');
    if (!r.ok) throw new Error('HTTP ' + r.status);
    const arr = await r.json();
    const latest = arr[0];
    const localR = await (await fetch('version.json', { cache: 'no-store' })).json();
    if (latest.sha !== localR.sha) {
      showBanner('Ha atualizacoes! Local v' + (localR.short || '?') + ' > remoto v' + latest.sha.slice(0, 7) + '. Rode git pull + sync.',
        'https://github.com/' + repo + '/compare/' + localR.sha + '...' + latest.sha);
    } else {
      showBanner('Voce esta atualizado (v' + (localR.short || '?') + ').', null);
    }
  } catch (e) {
    showBanner('Nao foi possivel verificar: ' + e.message, null);
  } finally {
    btn.disabled = false; btn.textContent = 'Verificar';
  }
}

// Init
initTheme();
initVersion();
initSidebarState();
renderNav();
if (FILES.length) loadFile(FILES[0].id); else document.getElementById('emptyHint').hidden = false;
</script>
</body>
