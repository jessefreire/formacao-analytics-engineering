.content pre code { background: none; padding: 0; font-size: var(--fs-sm); line-height: 1.6; overflow-wrap: normal; white-space: pre; }
.pre-copiar { position: absolute; top: 6px; right: 6px; min-height: 32px; padding: 0 10px; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); background: var(--bg); color: var(--fg-soft); font-size: var(--fs-xs); opacity: 0; transition: opacity var(--dur) var(--ease); }
.pre-wrap:hover .pre-copiar, .pre-copiar:focus-visible { opacity: 1; }
@media (pointer: coarse) { .pre-copiar { opacity: 1; min-height: var(--tap); } }
