.btn-texto { border-color: transparent; background: transparent; color: var(--accent); }
.chip, .pn-chip, .grf-tipo, .dsf-bt {
  display: inline-flex; align-items: center; gap: 6px; min-height: var(--tap); padding: 0 var(--sp-3);
  border: 1px solid var(--border-strong); border-radius: 999px; background: var(--bg); color: var(--fg-soft);
  font-size: var(--fs-sm); white-space: nowrap; transition: background var(--dur) var(--ease), border-color var(--dur) var(--ease);
}
.chip:hover, .pn-chip:hover, .grf-tipo:hover, .dsf-bt:hover { border-color: var(--accent); }
.chip[aria-pressed="true"], .pn-chip[aria-pressed="true"], .grf-tipo[aria-pressed="true"], .dsf-bt[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: var(--on-accent); font-weight: 500; }
.campo, .pn-busca, .grf-busca, .kit-linha input[type="text"], .kit-linha select, .kit-linha input[type="number"], .kit-linha input[type="file"] {
  min-height: var(--tap); padding: 0 var(--sp-3); border: 1px solid var(--border-strong); border-radius: var(--radius);
  background: var(--bg); color: var(--fg); font-size: var(--fs-ui); min-width: 0;
}
.campo:focus-visible, .pn-busca:focus-visible, .grf-busca:focus-visible { outline-offset: 0; border-color: var(--accent); }
/* trilho de filtros: o scroll horizontal fica DENTRO do trilho, nunca na página */
.trilho { display: flex; gap: var(--sp-2); margin-inline: calc(-1 * var(--sp-4)); padding-inline: var(--sp-4); overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: none; }
