.dsf-item[data-st="wip"] { background: var(--warn-bg); border-color: var(--warn-border); }
.dsf-item[data-st="done"] { background: var(--bg); border-color: var(--accent); }
.dsf-etapa { font: 500 var(--fs-sm)/1.6 var(--mono); color: var(--muted); font-variant-numeric: tabular-nums; }
