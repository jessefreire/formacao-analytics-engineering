.rx-sev.critico { background: var(--bad-bg); color: var(--bad); } .rx-sev.medio { background: var(--warn-bg); color: var(--warn); } .rx-sev.leve { background: var(--neutral-bg); color: var(--neutral); }
.rx-onde { font: var(--fs-sm)/1.5 var(--mono); color: var(--fg-soft); overflow-wrap: anywhere; }
.rx-achado p { margin: 0; font-size: var(--fs-sm); line-height: 1.6; color: var(--fg-soft); max-width: var(--measure); }
.rx-rolagem { max-height: 66vh; overflow: auto; border: 1px solid var(--border); border-radius: var(--radius); }
.rx-tabela { width: 100%; min-width: 40rem; border-collapse: collapse; font-size: var(--fs-sm); }
