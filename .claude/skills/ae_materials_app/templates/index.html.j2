@media (max-width: 639px) {
  .rx-rolagem { max-height: none; overflow: visible; border: 0; }
  .content .rx-tabela, .content .rx-tabela tbody, .rx-rolagem .rx-tabela, .rx-rolagem .rx-tabela tbody { display: block; width: 100%; min-width: 0; }
  .rx-tabela thead { display: none; }
  .rx-tabela tr { display: block; margin-bottom: var(--sp-3); padding: var(--sp-3) var(--sp-4); border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); box-shadow: var(--shadow-sm); }
  .rx-tabela td { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: var(--sp-3); padding: 3px 0; border: 0; overflow-wrap: anywhere; }
  .rx-tabela td::before { content: attr(data-rotulo); color: var(--muted); font: 500 var(--fs-xs)/1.7 var(--mono); }
}

/* ----- grafo ----- */
.grf-barra { display: flex; flex-direction: column; gap: var(--sp-3); margin: var(--sp-4) 0 var(--sp-3); }
@media (min-width: 640px) { .grf-barra { flex-direction: row; align-items: center; } .grf-barra .trilho { flex: 1; } .grf-busca { width: 240px; margin-left: auto; } }
.grf-tipo[aria-pressed="false"] { opacity: .5; }
.grf-ponto { width: 10px; height: 10px; border-radius: 50%; flex: none; }
.grf-busca { width: 100%; }
.grf-tela { height: 68dvh; min-height: 360px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--card); touch-action: none; }
.grf-dica { margin-top: var(--sp-2); font-size: var(--fs-xs); color: var(--muted); }

/* ----- desafio ----- */
.dsf-resumo { display: flex; align-items: center; gap: var(--sp-3); flex-wrap: wrap; margin-top: var(--sp-3); }
.dsf-barra { flex: 1 1 200px; height: 8px; min-width: 140px; background: var(--accent-soft); border-radius: 999px; overflow: hidden; }
.dsf-barra > span { display: block; height: 100%; background: var(--accent); border-radius: 999px; transition: width .4s var(--ease); }
