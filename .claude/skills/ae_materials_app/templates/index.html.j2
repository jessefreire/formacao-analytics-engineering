.dsf-opcional { font: 500 var(--fs-xs)/1.5 var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); border: 1px solid var(--border-strong); border-radius: 999px; padding: 0 var(--sp-2); }
.dsf-oque, .dsf-meta, .dsf-est { grid-column: 2; }
.dsf-oque { font-size: var(--fs-sm); line-height: 1.6; color: var(--fg-soft); max-width: var(--measure); }
.dsf-meta { font-size: var(--fs-xs); color: var(--muted); overflow-wrap: anywhere; }
.dsf-trava { color: var(--warn); font-weight: 500; }
.dsf-est { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-top: var(--sp-2); }
.dsf-aviso { margin-top: var(--sp-6); font-size: var(--fs-xs); color: var(--muted); max-width: var(--measure); }

/* ----- kit visual ----- */
.kit { display: grid; grid-template-columns: 1fr; gap: var(--sp-4); margin-top: var(--sp-4); }
.kit > div:last-child { order: -1; }
@media (min-width: 1200px) { .kit { grid-template-columns: 340px minmax(0, 1fr); align-items: start; } .kit > div:last-child { order: 0; } }
.kit-form { display: grid; gap: var(--sp-4); padding: var(--sp-4); border: 1px solid var(--border); border-radius: var(--radius); background: var(--card); font-size: var(--fs-ui); color: var(--fg-soft); min-width: 0; }
.kit-form fieldset { border: 0; display: grid; gap: var(--sp-2); min-width: 0; }
.kit-form legend { font: 600 var(--fs-xs)/1.4 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-bottom: var(--sp-2); }
.kit-linha { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-3); min-height: var(--tap); min-width: 0; }
.kit-linha label { flex: 1; min-width: 0; align-self: stretch; display: flex; align-items: center; }
.kit-linha input[type="text"], .kit-linha select, .kit-linha input[type="number"], .kit-linha input[type="file"] { width: 55%; max-width: 100%; }
.kit-linha input[type="checkbox"] { width: 22px; height: 22px; accent-color: var(--accent); }
.kit-linha input[type="color"] { width: 56px; height: var(--tap); padding: 2px; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); background: var(--bg); }
.kit-cores { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-2); }
.kit-cores input { width: 100%; height: var(--tap); padding: 2px; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); background: var(--bg); }
.kit-preview { overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius); background: var(--card); box-shadow: var(--shadow-md); }
.kit-preview svg { display: block; width: 100%; height: auto; }
.kit-contraste { margin-top: var(--sp-3); padding: var(--sp-3) var(--sp-4); border: 1px solid var(--border); border-radius: var(--radius); background: var(--card); font-size: var(--fs-sm); }
.kit-contraste ul { margin: var(--sp-2) 0 0; padding: 0; list-style: none; }
.kit-contraste li { display: flex; justify-content: space-between; gap: var(--sp-3); padding: 4px 0; color: var(--fg-soft); }
.kit-ok { color: var(--ok); font-weight: 600; } .kit-falha { color: var(--bad); font-weight: 600; }
.kit-acoes { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-top: var(--sp-3); }

/* ----- início ----- */
.ini-hero { position: relative; margin: calc(-1 * var(--sp-4)) calc(-1 * var(--sp-4)) var(--sp-6); padding: var(--sp-8) var(--sp-4); color: #fff; background-color: var(--brand-dark);
  background-image: linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px); background-size: 56px 56px; }
@media (min-width: 640px) { .ini-hero { margin: calc(-1 * var(--sp-6)) calc(-1 * var(--sp-6)) var(--sp-8); padding: var(--sp-12) var(--sp-6); } }
@media (min-width: 901px) { .ini-hero { margin: calc(-1 * var(--sp-8)) calc(-1 * var(--sp-8)) var(--sp-8); padding: var(--sp-12) var(--sp-8); } }
@media (min-width: 1200px) { .ini-hero { margin: calc(-1 * var(--sp-12)) -56px var(--sp-8); padding: var(--sp-16) 56px; } }
.ini-hero > * { max-width: 46rem; }
.ini-eyebrow { font: 500 var(--fs-xs)/1.4 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.7); }
.ini-hero h1 { margin: var(--sp-3) 0; padding: 0; border: 0; font-size: clamp(1.9rem, 1.2rem + 3vw, 2.75rem); font-weight: 400; line-height: 1.1; letter-spacing: -.02em; text-wrap: balance; }
.ini-hero h1 b { font-weight: 700; }
.ini-hero p { color: rgba(255,255,255,.76); max-width: 40rem; }
.ini-busca { display: flex; align-items: center; gap: var(--sp-3); width: 100%; max-width: 32rem; margin-top: var(--sp-6); min-height: 52px; padding: 0 var(--sp-4); text-align: left;
  border: 1px solid rgba(255,255,255,.22); border-radius: var(--radius); background: rgba(255,255,255,.08); color: rgba(255,255,255,.8); font-size: var(--fs-body); }
.ini-busca:hover { background: rgba(255,255,255,.13); }
.ini-busca span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ini-busca kbd { display: none; color: rgba(255,255,255,.7); border-color: rgba(255,255,255,.25); }
@media (pointer: fine) { .ini-busca kbd { display: inline-block; } }
.ini-secao { margin: var(--sp-8) 0 var(--sp-3); font: 500 var(--fs-xs)/1.4 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
.ini-kpis { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-3); }
@media (min-width: 640px) { .ini-kpis { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
.ini-kpi { padding: var(--sp-4); border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); box-shadow: var(--shadow-sm); min-width: 0; }
.ini-kpi b { display: block; font: 500 var(--fs-2xl)/1.1 var(--mono); color: var(--accent); }
.ini-kpi span { display: block; margin-top: 4px; font-size: var(--fs-sm); color: var(--muted); }
.ini-atalhos { display: grid; grid-template-columns: 1fr; gap: var(--sp-3); }
@media (min-width: 640px) { .ini-atalhos { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (min-width: 1200px) { .ini-atalhos { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
.ini-card { display: flex; gap: var(--sp-3); align-items: flex-start; min-width: 0; min-height: 88px; padding: var(--sp-4); text-align: left; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); box-shadow: var(--shadow-sm); transition: box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease), transform var(--dur) var(--ease); }
.ini-card:hover { box-shadow: var(--shadow-md); border-color: var(--accent); transform: translateY(-1px); }
.ini-card .ico-caixa { display: grid; place-items: center; flex: none; width: 40px; height: 40px; border-radius: 10px; background: var(--accent-soft); color: var(--accent); }
.ini-card strong { display: block; font-size: var(--fs-body); font-weight: 600; color: var(--fg); }
.ini-card small { display: block; margin-top: 2px; font-size: var(--fs-sm); line-height: 1.5; color: var(--muted); }
.ini-recentes { list-style: none; display: grid; gap: 2px; }
.ini-recentes button { display: flex; align-items: center; gap: var(--sp-3); width: 100%; min-height: var(--tap); padding: 6px var(--sp-3); text-align: left; border-radius: var(--radius-sm); color: var(--fg-soft); font-size: var(--fs-ui); }
.ini-recentes button:hover { background: var(--accent-soft); color: var(--fg); }
.ini-recentes small { margin-left: auto; flex: none; color: var(--muted); font-size: var(--fs-xs); }
.ini-recentes span { min-width: 0; overflow-wrap: anywhere; }

/* ========== PALETA DE BUSCA (Ctrl+K) ========== */
.paleta { position: fixed; inset: 0; z-index: 90; display: flex; align-items: flex-start; justify-content: center; padding: max(var(--sp-4), env(safe-area-inset-top)) var(--sp-3) var(--sp-3); background: var(--scrim); -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px); }
@media (min-width: 640px) { .paleta { padding-top: 12vh; } }
.paleta-caixa { display: flex; flex-direction: column; width: 100%; max-width: 40rem; max-height: min(34rem, calc(100dvh - 2rem)); overflow: hidden; border: 1px solid var(--border-strong); border-radius: var(--radius-lg); background: var(--bg); box-shadow: var(--shadow-lg); animation: fadeIn .18s var(--ease); }
.paleta-campo { display: flex; align-items: center; gap: var(--sp-3); padding: 0 var(--sp-4); border-bottom: 1px solid var(--border); color: var(--muted); }
.paleta-campo input { flex: 1; min-width: 0; min-height: 56px; border: 0; outline: 0; background: transparent; color: var(--fg); font-size: var(--fs-body); }
.paleta-lista { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: var(--sp-2); list-style: none; }
.paleta-grupo { padding: var(--sp-3) var(--sp-3) 4px; font: 500 var(--fs-xs)/1.4 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
.paleta-item { display: flex; align-items: center; gap: var(--sp-3); width: 100%; min-height: var(--tap); padding: 8px var(--sp-3); text-align: left; border-radius: var(--radius-sm); }
.paleta-item[aria-selected="true"] { background: var(--accent-soft); color: var(--fg); box-shadow: inset 3px 0 0 var(--accent); }
.paleta-item strong { font-weight: 500; font-size: var(--fs-ui); overflow-wrap: anywhere; }
.paleta-item small { display: block; font-size: var(--fs-xs); color: var(--muted); overflow-wrap: anywhere; }
.paleta-item mark { background: color-mix(in srgb, var(--accent-2) 35%, transparent); color: inherit; border-radius: 2px; }
.paleta-vazio { padding: var(--sp-8) var(--sp-4); text-align: center; color: var(--muted); font-size: var(--fs-ui); }
.paleta-dica { display: none; gap: var(--sp-4); padding: var(--sp-2) var(--sp-4); border-top: 1px solid var(--border); color: var(--muted); font-size: var(--fs-xs); }
@media (pointer: fine) { .paleta-dica { display: flex; } }
</style>
</head>
