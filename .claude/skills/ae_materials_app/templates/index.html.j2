  const inicial = FILES.some(f => f.id === hash) ? hash
    : FILES.some(f => f.id === 'inicio') ? 'inicio' : (visiveis()[0] || {}).id;
  if (inicial) loadFile(inicial, { semHistorico: true }); else $('emptyHint').hidden = false;
}
</script>
</body>
</html>
