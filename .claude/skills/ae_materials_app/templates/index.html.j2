      <a class="brand" href="#" id="brandHome" aria-label="Formação AE — ir para o início">
        <span class="brand-mark" aria-hidden="true">AE</span>
        <span class="brand-text">Formação AE</span>
      </a>
      <div class="sb-actions">
        <button class="icon-btn only-desktop" id="sidebarToggle" type="button" aria-label="Recolher painel" aria-expanded="true" title="Recolher painel (Ctrl+B)"><svg class="ico" aria-hidden="true"><use href="#i-panel"/></svg></button>
        <button class="icon-btn js-theme" id="themeToggle" type="button" aria-label="Alternar tema claro e escuro" aria-pressed="false" title="Alternar tema"><svg class="ico ico-moon" aria-hidden="true"><use href="#i-moon"/></svg><svg class="ico ico-sun" aria-hidden="true"><use href="#i-sun"/></svg></button>
