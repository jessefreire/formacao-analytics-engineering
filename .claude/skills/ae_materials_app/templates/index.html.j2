<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#1c1d2f">
<title>Formação AE — Materiais</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<style>
/* ==========================================================================
   Formação AE — design system
   Autoria: Jessé Freire · Indicium AI.
   Tokens da identidade Indicium AI (azul #3a58ee, Inter + Roboto Mono, faixas #1c1d2f).
   Mobile-first: a base vale para 320px; sm ≥ 640, lg ≥ 901 (sidebar fixa), xl ≥ 1200.
   Regras de contraste medidas: texto pequeno usa --muted (≥ 5,9:1); --dim só ≥ 14px.
   ========================================================================== */
:root {
  color-scheme: light;
  /* ---------- marca ---------- */
  --brand-dark: #1c1d2f; --brand-blue: #3a58ee; --brand-atlantic: #699bfb; --brand-lavender: #dedaf4;

  /* ---------- superfícies e texto (claro) ---------- */
  --bg: #ffffff; --card: #f5f6fb; --code-bg: #f5f6fb;
  --border: #e2e4f0; --border-strong: #c9cbe0;
  --fg: #0d0e1c;          /* dado */
  --fg-soft: #3d3f5c;     /* apoio */
  --muted: #5a5d7a;       /* rótulo: 6,4:1 no branco, 5,9:1 no cartão */
  --dim: #7b7e9e;         /* decorativo ou texto ≥ 14px (3,9:1) */

  --accent: #3a58ee; --accent-strong: #2540cc; --accent-soft: #eef1fd; --accent-2: #699bfb;
  --lav: #dedaf4; --on-accent: #ffffff;

  /* ---------- semântica (texto sobre o fundo -bg ≥ 4,5:1) ---------- */
  --ok: #15803d; --ok-bg: #dcfce7;
  --warn: #92400e; --warn-bg: #fef9c3; --warn-border: #fde68a; --warn-fg: #92400e;
  --bad: #b91c1c; --bad-bg: #fee2e2;
  --info: #2540cc; --info-bg: #eef1fd;
  --violet: #5b4bc4; --violet-bg: #dedaf4;
  --neutral: #5a5d7a; --neutral-bg: #eef0f8;
  /* traço de gráfico (≥ 3:1 no branco): mais vivo que o tom de texto */
  --ok-anel: #16a34a; --warn-anel: #d97706; --bad-anel: #dc2626;

  /* ---------- cores de gráfico (mesma família nos dois temas) ---------- */
  --c-modulo: #3a58ee; --c-material: #7b7e9e; --c-etapa: #b45309; --c-skill: #16a34a; --c-ferramenta: #5b4bc4;

  /* ---------- forma ---------- */
  --radius-sm: 6px; --radius-md: 12px; --radius-lg: 20px; --radius: 12px;
  --shadow-sm: 0 1px 4px rgba(58,88,238,.06);
  --shadow-md: 0 2px 12px rgba(58,88,238,.10);
  --shadow-lg: 0 8px 32px rgba(58,88,238,.14);
  --grid-line: rgba(58,88,238,.05);
  --scrim: rgba(13,14,28,.55);

  /* ---------- escala de espaçamento (4/8/12/16/24/32/48/64) ---------- */
  --sp-1: .25rem; --sp-2: .5rem; --sp-3: .75rem; --sp-4: 1rem; --sp-6: 1.5rem; --sp-8: 2rem; --sp-12: 3rem; --sp-16: 4rem;

  /* ---------- escala tipográfica (mínimo de leitura: 12px) ---------- */
  --font: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
  --mono: "Roboto Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  --fs-xs: .75rem;      /* 12px — rótulo, legenda */
  --fs-sm: .8125rem;    /* 13px — metadado, tabela, código */
  --fs-ui: .875rem;     /* 14px — navegação, botão */
  --fs-body: 1rem;      /* 16px — leitura */
  --fs-lg: 1.25rem; --fs-xl: 1.5rem; --fs-2xl: 2rem;

  --measure: 68ch;        /* linha de texto corrido */
  --measure-wide: 112ch;  /* teto do container (tabela, pre) */

  --sidebar-w: 300px;
  --tap: 44px;            /* alvo de toque; 36px com ponteiro fino (abaixo) */
  --dur: 200ms; --ease: cubic-bezier(.4, 0, .2, 1);
}
@media (pointer: fine) { :root { --tap: 36px; } }

[data-theme="dark"] {
  color-scheme: dark;
  --bg: #0f1120; --card: #1c1d2f; --code-bg: #171828;
  --border: #2b2d45; --border-strong: #3d4066;
  --fg: #f2f3fa; --fg-soft: #c9cbe0; --muted: #9a9db8; --dim: #7b7e9e;
  --accent: #8ca0ff; --accent-strong: #aac0ff; --accent-soft: #2c3566; --accent-2: #699bfb;
  --lav: #3a3860; --on-accent: #0d0e1c;
  --ok: #4ade80; --ok-bg: #163826;
  --warn: #fbbf24; --warn-bg: #3d3220; --warn-border: #574518; --warn-fg: #f2d78e;
  --bad: #f87171; --bad-bg: #442629;
  --info: #9fb1ff; --info-bg: #2c3566;
  --violet: #c3bcff; --violet-bg: #3a3663;
  --neutral: #9a9db8; --neutral-bg: #2b2d45;
  --ok-anel: #4ade80; --warn-anel: #fbbf24; --bad-anel: #f87171;
  --c-modulo: #8ca0ff; --c-material: #7b7e9e; --c-etapa: #fbbf24; --c-skill: #4ade80; --c-ferramenta: #c3bcff;
  --shadow-sm: none; --shadow-md: 0 4px 16px rgba(0,0,0,.30); --shadow-lg: 0 8px 32px rgba(0,0,0,.40);
  --grid-line: rgba(255,255,255,.045);
  --scrim: rgba(0,0,0,.65);
}
@media (prefers-reduced-motion: reduce) {
  :root { --dur: .01ms; }
  *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; scroll-behavior: auto !important; }
}

/* ========== BASE ========== */
*, *::before, *::after { box-sizing: border-box; }
* { margin: 0; padding: 0; }
html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
body {
  background: var(--bg); color: var(--fg);
  font-family: var(--font); font-size: var(--fs-body); line-height: 1.6;
  -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
  overflow: hidden;
}
button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
input, select, textarea { font: inherit; color: inherit; }
svg { flex: none; }
:focus-visible { outline: 2px solid var(--accent-2); outline-offset: 2px; }
[hidden] { display: none !important; }
.mono { font-family: var(--mono); }
.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
@media (pointer: coarse) { input, select, textarea { font-size: 16px; } }   /* evita o zoom automático do iOS */

@keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

/* ========== CASCA ========== */
.app { height: 100dvh; }
.shell { display: flex; flex-direction: column; height: 100dvh; min-width: 0; }
@media (min-width: 901px) {
  .app { display: grid; grid-template-columns: var(--sidebar-col, var(--sidebar-w)) minmax(0, 1fr); }
  [data-sidebar-collapsed="true"] .app { --sidebar-col: 68px; }
}

/* ---------- ícones e botões de ícone ---------- */
.ico { width: 20px; height: 20px; stroke: currentColor; fill: none; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
.icon-btn {
  display: inline-grid; place-items: center; flex: none;
  width: var(--tap); height: var(--tap); border-radius: var(--radius-sm); color: inherit;
  transition: background var(--dur) var(--ease);
}
.only-mobile { display: inline-grid; }
@media (min-width: 901px) { .only-mobile { display: none; } }
.only-desktop { display: none; }
@media (min-width: 901px) { .only-desktop { display: inline-grid; } }
.ico-sun { display: none; }
[data-theme="dark"] .ico-sun { display: block; }
[data-theme="dark"] .ico-moon { display: none; }

/* ========== SIDEBAR (faixa escura da marca, nos dois temas) ========== */
.sidebar {
  --sb-fg: #ffffff; --sb-fg-soft: rgba(255,255,255,.76); --sb-muted: rgba(255,255,255,.62);
  --sb-line: rgba(255,255,255,.10); --sb-hover: rgba(255,255,255,.07);
  --sb-active: rgba(140,160,255,.22); --sb-accent: #8ca0ff;
  position: fixed; z-index: 60; inset: 0 auto 0 0;
  width: min(100vw, 360px); height: 100dvh;
  display: flex; flex-direction: column;
  background: var(--brand-dark); color: var(--sb-fg);
  padding-top: env(safe-area-inset-top);
  transform: translateX(-100%); visibility: hidden;
  transition: transform var(--dur) var(--ease), visibility 0s linear var(--dur);
}
.sidebar.open { transform: none; visibility: visible; transition: transform var(--dur) var(--ease); box-shadow: var(--shadow-lg); }
@media (min-width: 901px) {
  .sidebar { position: relative; inset: auto; width: auto; transform: none; visibility: visible; z-index: 10; box-shadow: none; transition: none; border-right: 1px solid var(--sb-line); }
}
.sb-head {
  display: flex; align-items: center; justify-content: space-between; gap: var(--sp-2);
  min-height: 64px; padding: var(--sp-2) var(--sp-2) var(--sp-2) var(--sp-4);
  background-image: linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px);
  background-size: 56px 56px; border-bottom: 1px solid var(--sb-line);
}
.brand { display: flex; align-items: center; gap: 10px; min-width: 0; color: inherit; text-decoration: none; }
.brand-mark { display: grid; place-items: center; flex: none; width: 32px; height: 32px; border-radius: 8px; background: var(--brand-blue); color: #fff; font: 500 13px/1 var(--mono); letter-spacing: .04em; }
.brand-text { font-weight: 600; font-size: 15px; letter-spacing: -.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sb-actions { display: flex; align-items: center; gap: 2px; }
.sidebar .icon-btn:hover { background: var(--sb-hover); }
.sb-search {
  display: flex; align-items: center; gap: 10px; width: calc(100% - 24px); margin: var(--sp-3);
  min-height: var(--tap); padding: 0 var(--sp-3); text-align: left;
  border: 1px solid var(--sb-line); border-radius: var(--radius); background: rgba(255,255,255,.05);
  color: var(--sb-fg-soft); font-size: var(--fs-ui); transition: background var(--dur) var(--ease), border-color var(--dur) var(--ease);
}
.sb-search:hover { background: rgba(255,255,255,.09); border-color: rgba(255,255,255,.22); }
.sb-search span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
kbd { font: 500 var(--fs-xs)/1 var(--mono); padding: 3px 6px; border: 1px solid var(--sb-line, var(--border)); border-radius: 4px; color: var(--sb-muted, var(--muted)); }
.sb-search kbd { display: none; }
@media (pointer: fine) { .sb-search kbd { display: inline-block; } }

/* ---------- navegação em grupos ---------- */
.nav { flex: 1; min-height: 0; overflow-y: auto; overflow-x: hidden; overscroll-behavior: contain; padding: 0 var(--sp-2) var(--sp-4); }
.nav-group { margin-bottom: 2px; }
.nav-label { margin: 0; font: inherit; }
.nav-group-btn {
  display: flex; align-items: center; gap: 10px; width: 100%; min-height: var(--tap);
  padding: 6px 10px; border-radius: var(--radius-sm); text-align: left; color: var(--sb-fg-soft);
  font: 600 var(--fs-ui)/1.3 var(--font); letter-spacing: 0;
  transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
}
.nav-group-btn:hover { background: var(--sb-hover); color: var(--sb-fg); }
.nav-group-btn .ico { width: 18px; height: 18px; color: var(--sb-muted); }
.nav-group-btn[aria-expanded="true"] .ico:first-child { color: var(--sb-accent); }
.nav-group-btn[aria-expanded="true"] { color: var(--sb-fg); }
.nav-group-name { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.nav-count { font: 500 var(--fs-xs)/1 var(--mono); color: var(--sb-muted); }
.nav-chev { width: 16px; height: 16px; transition: transform var(--dur) var(--ease); }
.nav-group-btn[aria-expanded="true"] .nav-chev { transform: rotate(180deg); }
.nav-items { margin: 2px 0 8px 19px; padding-left: 10px; border-left: 1px solid var(--sb-line); }
.nav-link {
  display: flex; align-items: center; min-height: var(--tap); padding: 6px 10px; border-radius: var(--radius-sm);
  color: var(--sb-fg-soft); text-decoration: none; font-size: var(--fs-ui); line-height: 1.35;
  overflow-wrap: anywhere; transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
}
.nav-link:hover { background: var(--sb-hover); color: var(--sb-fg); }
.nav-link.active { background: var(--sb-active); color: #fff; font-weight: 500; box-shadow: inset 3px 0 0 var(--sb-accent); }
.nav-vazio { padding: var(--sp-4); color: var(--sb-muted); font-size: var(--fs-ui); }

/* ---------- rodapé da sidebar ---------- */
.sb-foot { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-2); padding: var(--sp-2) var(--sp-3) calc(var(--sp-2) + env(safe-area-inset-bottom)); border-top: 1px solid var(--sb-line); }
.version-badge { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 4px 10px; border-radius: 999px; background: rgba(255,255,255,.07); color: var(--sb-fg-soft); font: 500 var(--fs-xs)/1.4 var(--mono); }
.version-check { min-height: var(--tap); padding: 0 var(--sp-3); border: 1px solid var(--sb-line); border-radius: 999px; color: var(--sb-fg-soft); font-size: var(--fs-xs); transition: background var(--dur) var(--ease); }
.version-check:hover { background: var(--sb-hover); }
.version-check:disabled { opacity: .5; cursor: wait; }
.update-banner { display: flex; align-items: center; gap: var(--sp-2); padding: var(--sp-2) var(--sp-3); background: #3d3220; color: #f2d78e; border-top: 1px solid #574518; font-size: var(--fs-xs); }
.update-banner a { color: inherit; font-weight: 600; text-decoration: underline; }
.update-banner button { margin-left: auto; min-width: var(--tap); min-height: var(--tap); color: inherit; font-size: var(--fs-lg); line-height: 1; }

/* ---------- trilho (sidebar recolhida, só ≥ 901px) ---------- */
.rail { display: none; }
@media (min-width: 901px) {
  [data-sidebar-collapsed="true"] .sb-head { flex-direction: column; justify-content: flex-start; padding: var(--sp-3) 0; gap: var(--sp-2); }
  [data-sidebar-collapsed="true"] .brand-text, [data-sidebar-collapsed="true"] .sb-search span, [data-sidebar-collapsed="true"] .sb-search kbd,
  [data-sidebar-collapsed="true"] .sb-foot, [data-sidebar-collapsed="true"] .update-banner { display: none; }
  [data-sidebar-collapsed="true"] .sb-actions { flex-direction: column; }
  [data-sidebar-collapsed="true"] .sb-search { width: var(--tap); margin: var(--sp-2) auto; padding: 0; justify-content: center; }
  [data-sidebar-collapsed="true"] .nav-group { display: none; }
  [data-sidebar-collapsed="true"] .rail { display: flex; flex-direction: column; align-items: center; gap: 4px; }
  [data-sidebar-collapsed="true"] .nav { padding: 0 var(--sp-2); }
  .rail-btn { position: relative; display: grid; place-items: center; width: var(--tap); height: var(--tap); border-radius: var(--radius-sm); color: var(--sb-fg-soft); transition: background var(--dur) var(--ease); }
  .rail-btn:hover { background: var(--sb-hover); color: var(--sb-fg); }
  .rail-btn.ativo { background: var(--sb-active); color: #fff; }
}

/* ---------- alça de redimensionar (só desktop) ---------- */
.resize-handle { display: none; }
@media (min-width: 901px) {
  .resize-handle { display: block; position: absolute; top: 0; right: -3px; bottom: 0; width: 6px; cursor: col-resize; z-index: 40; touch-action: none; transition: background var(--dur) var(--ease); }
  .resize-handle:hover, .resize-handle.dragging { background: var(--accent-2); }
}

/* ========== TOPBAR (só < 901px) ========== */
.topbar {
  display: flex; align-items: center; gap: 2px; flex: none; color: #fff; background: var(--brand-dark);
  min-height: calc(56px + env(safe-area-inset-top)); padding: env(safe-area-inset-top) var(--sp-2) 0;
}
.topbar-titulo { flex: 1; min-width: 0; padding: 0 var(--sp-2); font-weight: 600; font-size: 15px; letter-spacing: -.01em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.topbar .icon-btn:hover { background: rgba(255,255,255,.08); }
@media (min-width: 901px) { .topbar { display: none; } }
.scrim { position: fixed; inset: 0; z-index: 55; background: var(--scrim); }
@media (min-width: 901px) { .scrim { display: none !important; } }

/* ========== ÁREA PRINCIPAL ========== */
.main { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: var(--sp-4) var(--sp-4) var(--sp-8); }
@media (min-width: 640px) { .main { padding: var(--sp-6) var(--sp-6) var(--sp-8); } }
@media (min-width: 901px) { .main { padding: var(--sp-8) var(--sp-8) var(--sp-12); } }
@media (min-width: 1200px) { .main { padding: var(--sp-12) 56px var(--sp-16); } }
.main:focus { outline: none; }
.content { width: 100%; max-width: var(--measure-wide); margin-inline: auto; animation: fadeIn .3s var(--ease); }
.crumbs { max-width: var(--measure-wide); margin: 0 auto var(--sp-4); font-size: var(--fs-xs); color: var(--muted); }
.crumbs ol { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 6px; list-style: none; }
.crumbs li { display: inline-flex; align-items: center; gap: 6px; min-width: 0; }
.crumbs li + li::before { content: "/"; color: var(--dim); }
.crumbs a, .crumbs button { display: inline-flex; align-items: center; justify-content: center; min-width: 48px; min-height: var(--tap); padding: 0 6px; margin-inline: -6px; color: var(--muted); text-decoration: none; }
.crumbs a:hover, .crumbs button:hover { color: var(--accent); text-decoration: underline; }
.crumbs [aria-current] { color: var(--fg-soft); font-weight: 500; overflow-wrap: anywhere; }
.crumbs ol { row-gap: 0; }

.main-header { margin-bottom: var(--sp-6); padding-bottom: var(--sp-4); border-bottom: 1px solid var(--border); }
.module-badge { display: none; }
.module-badge-antigo { display: inline-block; margin-bottom: var(--sp-3); padding: 3px 10px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); font: 500 var(--fs-xs)/1.5 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
[data-theme="dark"] .module-badge { color: var(--accent); }
.main-title { font-size: clamp(1.5rem, 1.1rem + 2vw, 2.25rem); font-weight: 400; line-height: 1.15; letter-spacing: -.02em; text-wrap: balance; }
.main-title b { font-weight: 700; }
.main-meta { margin-top: var(--sp-2); color: var(--muted); font-size: var(--fs-sm); overflow-wrap: anywhere; }
.main-header-empty { display: flex; align-items: center; min-height: 2.5rem; color: var(--muted); font-size: var(--fs-ui); }

/* ========== BARRA ANTERIOR / PRÓXIMO (no fluxo, nunca cobre conteúdo) ========== */
.file-nav {
  display: flex; gap: var(--sp-2); flex: none; align-items: stretch;
  padding: var(--sp-2) var(--sp-3) calc(var(--sp-2) + env(safe-area-inset-bottom));
  background: color-mix(in srgb, var(--bg) 92%, transparent);
  -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  border-top: 1px solid var(--border);
}
@media (min-width: 901px) { .file-nav { padding: var(--sp-3) var(--sp-8); } }
.file-nav-btn {
  flex: 1 1 0; min-width: 0; display: flex; align-items: center; gap: var(--sp-2); text-align: left;
  min-height: 56px; padding: var(--sp-2) var(--sp-3); border: 1px solid var(--border); border-radius: var(--radius);
  background: var(--card); transition: border-color var(--dur) var(--ease), background var(--dur) var(--ease), transform var(--dur) var(--ease);
}
.file-nav-btn.next { flex-direction: row-reverse; text-align: right; }
.file-nav-btn:hover:not(:disabled) { border-color: var(--accent); background: var(--accent-soft); }
.file-nav-btn:active:not(:disabled) { transform: scale(.985); }
.file-nav-btn:disabled { visibility: hidden; }
.fn-arrow { flex: none; display: grid; place-items: center; color: var(--accent); }
.fn-meta { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; overflow: hidden; }
.file-nav-btn.next .fn-meta { align-items: flex-end; }
.fn-caption { font: 500 var(--fs-xs)/1.2 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
.fn-title { max-width: 100%; font-size: var(--fs-sm); font-weight: 500; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; }

/* ========== BOTÕES E CHIPS ========== */
.btn, .bib-btn, .dsf-acao {
  display: inline-flex; align-items: center; justify-content: center; gap: var(--sp-2);
  min-height: var(--tap); padding: 0 var(--sp-4); border: 1px solid var(--border-strong); border-radius: var(--radius);
  background: var(--bg); color: var(--fg); font-size: var(--fs-ui); font-weight: 500; text-decoration: none;
  transition: background var(--dur) var(--ease), border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
}
.btn:hover:not(:disabled), .bib-btn:hover:not(:disabled), .dsf-acao:hover:not(:disabled) { border-color: var(--accent); background: var(--accent-soft); }
.btn:active:not(:disabled), .bib-btn:active:not(:disabled), .dsf-acao:active:not(:disabled) { transform: scale(.985); }
.btn:disabled, .bib-btn:disabled, .dsf-acao:disabled { opacity: .45; cursor: not-allowed; }
