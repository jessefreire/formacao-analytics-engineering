.bib-gatilhos { display: flex; flex-wrap: wrap; gap: 6px; }
.bib-gatilho { font-size: var(--fs-xs); padding: 2px 8px; border-radius: 999px; background: var(--accent-soft); color: var(--fg-soft); }
.bib-acoes { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-top: auto; }

/* ----- raio-x ----- */
.rx-topo { display: grid; grid-template-columns: 1fr; gap: var(--sp-4); align-items: center; margin: var(--sp-4) 0; }
