            <div class="kit-linha"><label for="kPrim">Cor principal</label><input type="color" id="kPrim" value="${st.primaria}"></div>
          </fieldset>
          <fieldset><legend>Layout</legend>
            <div class="kit-linha"><label for="kModo">Modo</label><select id="kModo">${opt('claro', st.modo, 'Claro')}${opt('escuro', st.modo, 'Escuro')}</select></div>
            <div class="kit-linha"><label for="kNav">Navegação</label><select id="kNav">${opt('lateral', st.navegacao, 'Lateral')}${opt('topo', st.navegacao, 'No topo')}${opt('nenhuma', st.navegacao, 'Nenhuma')}</select></div>
            <div class="kit-linha"><label for="kFiltros">Barra de filtros</label><input type="checkbox" id="kFiltros"${st.filtros ? ' checked' : ''}></div>
            <div class="kit-linha"><label for="kCards">Cards de KPI</label><input type="number" id="kCards" min="${regras.limites.cards_min}" max="${regras.limites.cards_max}" value="${st.cards}"></div>
            <div class="kit-linha"><label for="kCols">Gráficos por linha</label><select id="kCols">${regras.limites.colunas_graficos.map(c => opt(c, st.colunas_graficos, c)).join('')}</select></div>
            <div class="kit-linha"><label for="kLinhas">Linhas de gráficos</label><input type="number" id="kLinhas" min="1" max="${regras.limites.linhas_graficos_max}" value="${st.linhas_graficos}"></div>
            <div class="kit-linha"><label for="kRaio">Cantos</label><select id="kRaio">${regras.grade.raios.map(r => opt(r, st.raio, r === 0 ? 'Retos' : r + ' px')).join('')}</select></div>
            <div class="kit-linha"><label for="kBorda">Borda nos cartões</label><input type="checkbox" id="kBorda"${st.borda ? ' checked' : ''}></div>
          </fieldset>
