.content strong { font-weight: 600; }
.content a { color: var(--accent); text-decoration: none; border-bottom: 1px solid transparent; }
.content a:hover { border-bottom-color: currentColor; }

/* ========== PAINÉIS (biblioteca, raio-x, kit, grafo, desafio, início) ========== */
.content:has(.painel), .content:has(.grf), .content:has(.ini) { max-width: none; }
