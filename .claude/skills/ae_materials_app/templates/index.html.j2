<script>
// ========== FILES AUTO-GENERATED ==========
const FILES = [
  // INJETADO AUTOMATICAMENTE POR ae-materials-app
];
// ========== END FILES ==========

// ========== UTILIDADES ==========
const $ = id => document.getElementById(id);
const lsGet = (k, padrao = null) => { try { const v = localStorage.getItem(k); return v === null ? padrao : v; } catch (e) { return padrao; } };
const lsSet = (k, v) => { try { localStorage.setItem(k, v); } catch (e) { /* modo privado ou cota cheia */ } };
const ic = (nome, extra = '') => `<svg class="ico ${extra}" aria-hidden="true" focusable="false"><use href="#i-${nome}"/></svg>`;
const normalizar = s => String(s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
const nomeGrupo = cat => cat.replace(' - ', ' · ');
const visiveis = () => FILES.filter(f => !f.oculto);
const desktop = window.matchMedia('(min-width: 901px)');

const ICONE_GRUPO = [
  [/^Config/i, 'sliders'], [/^Mapa/i, 'map'], [/^Raio-X/i, 'activity'], [/Desafio/i, 'flag'], [/Skills/i, 'package'],
  [/BanVic|Banco de Dados BanVic/i, 'database'], [/dbt|Engenharia de Dados/i, 'layers'], [/SQL/i, 'terminal'],
  [/Power BI|Dashboards/i, 'bar-chart'], [/Python/i, 'code'], [/Estat/i, 'percent'], [/Modelagem/i, 'share'],
  [/Storytelling/i, 'message'], [/Design/i, 'pen'], [/Introdu/i, 'compass'], [/\bAI\b|Productivity/, 'zap'],
];
const iconeDoGrupo = cat => (ICONE_GRUPO.find(([re]) => re.test(cat)) || [null, 'book'])[1];

// ========== ESTADO ==========
let currentFile = null;
let sidebarOpen = false;
let isCollapsed = lsGet('sidebarCollapsed') === 'true';
let gruposAbertos = new Set((() => { try { return JSON.parse(lsGet('navAbertos', 'null')) || ['Mapa']; } catch (e) { return ['Mapa']; } })());
const MIN_SIDEBAR = 220;
const MAX_SIDEBAR = 600;
const COLLAPSE_W = 68;

// ========== TEMA ==========
function aplicarTema(tema) {
  document.documentElement.setAttribute('data-theme', tema);
  document.querySelectorAll('.js-theme').forEach(b => b.setAttribute('aria-pressed', String(tema === 'dark')));
}
function initTheme() {
  aplicarTema(lsGet('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'));
}
function toggleTheme() {
  const proximo = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  aplicarTema(proximo);
  lsSet('theme', proximo);
  // Telas com canvas leem as cores dos tokens ao desenhar: precisam redesenhar.
  const atual = FILES.find(f => f.id === currentFile);
  if (atual && ['grafo', 'raiox', 'kit'].includes(atual.view)) loadFile(atual.id, { semHistorico: true });
}

// ========== SIDEBAR: RECOLHER (desktop) ==========
function updateSidebarToggleBtn() {
  const btn = $('sidebarToggle');
  btn.setAttribute('aria-expanded', String(!isCollapsed));
  btn.setAttribute('aria-label', isCollapsed ? 'Expandir painel' : 'Recolher painel');
  btn.setAttribute('title', (isCollapsed ? 'Expandir painel' : 'Recolher painel') + ' (Ctrl+B)');
}
function definirRecolhida(valor) {
  isCollapsed = valor;
  document.documentElement.setAttribute('data-sidebar-collapsed', String(valor));
  lsSet('sidebarCollapsed', String(valor));
  updateSidebarToggleBtn();
  renderNav();
}
function toggleSidebarCollapse() { definirRecolhida(!isCollapsed); }

// ========== SIDEBAR: REDIMENSIONAR (desktop) ==========
function initResizeHandle() {
  const handle = $('resizeHandle');
  let startX = 0, startW = 0, pointerId = null;

  function onPointerMove(e) {
    let novaLargura = startW + (e.clientX - startX);
    if (isCollapsed) {
      if (novaLargura > COLLAPSE_W + 24) definirRecolhida(false); else return;
    } else if (novaLargura < COLLAPSE_W + 24) {
      definirRecolhida(true);
      return;
    }
    novaLargura = Math.max(MIN_SIDEBAR, Math.min(MAX_SIDEBAR, novaLargura));
    document.documentElement.style.setProperty('--sidebar-w', novaLargura + 'px');
  }
  function onPointerUp() {
    document.removeEventListener('pointermove', onPointerMove);
    document.removeEventListener('pointerup', onPointerUp);
    handle.classList.remove('dragging');
    document.body.style.cursor = '';
    document.body.style.userSelect = '';
    if (!isCollapsed) lsSet('sidebarWidth', document.documentElement.style.getPropertyValue('--sidebar-w'));
    if (pointerId !== null && handle.hasPointerCapture(pointerId)) handle.releasePointerCapture(pointerId);
  }
  handle.addEventListener('pointerdown', e => {
    e.preventDefault();
    pointerId = e.pointerId;
    startX = e.clientX;
    startW = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--sidebar-w')) || 300;
    handle.classList.add('dragging');
    handle.setPointerCapture(e.pointerId);
    document.body.style.cursor = 'col-resize';
    document.body.style.userSelect = 'none';
    document.addEventListener('pointermove', onPointerMove);
    document.addEventListener('pointerup', onPointerUp);
  });
}
function initSidebarState() {
  const largura = lsGet('sidebarWidth');
  if (largura) document.documentElement.style.setProperty('--sidebar-w', largura);
  document.documentElement.setAttribute('data-sidebar-collapsed', String(isCollapsed));
  updateSidebarToggleBtn();
}

// ========== SIDEBAR: GAVETA (mobile) ==========
let focoAntesDaGaveta = null;
function toggleSidebar(abrir) {
  if (desktop.matches) return;
  sidebarOpen = abrir;
  $('sidebar').classList.toggle('open', abrir);
  $('mobileToggle').setAttribute('aria-expanded', String(abrir));
  $('scrim').hidden = !abrir;
  // Com a gaveta aberta, o resto da página não recebe foco nem leitor de tela.
  $('shell').inert = abrir;
  if (abrir) {
    focoAntesDaGaveta = document.activeElement;
    requestAnimationFrame(() => {
      const ativo = $('nav').querySelector('.nav-link.active');
      if (ativo) ativo.scrollIntoView({ block: 'center' }); else $('nav').scrollTop = 0;
      $('searchOpen').focus();
    });
  } else if (focoAntesDaGaveta) {
    $('mobileToggle').focus();
    focoAntesDaGaveta = null;
  }
}
function closeMobileMenu() { if (sidebarOpen) toggleSidebar(false); }

// ========== NAVEGAÇÃO EM GRUPOS ==========
function salvarAbertos() { lsSet('navAbertos', JSON.stringify([...gruposAbertos])); }
function agruparPorCat() {
  return visiveis().reduce((acc, f) => { (acc[f.cat] = acc[f.cat] || []).push(f); return acc; }, {});
}
function catAtual() { return (FILES.find(f => f.id === currentFile) || {}).cat; }

function renderNav() {
  const nav = $('nav');
  const rolagem = nav.scrollTop;
  const grupos = Object.entries(agruparPorCat());

  if (isCollapsed && desktop.matches) {
    nav.innerHTML = `<div class="rail">${grupos.map(([cat]) => `
      <button class="rail-btn ${cat === catAtual() ? 'ativo' : ''}" type="button" data-cat="${escapeHtml(cat)}"
              title="${escapeHtml(nomeGrupo(cat))}" aria-label="${escapeHtml(nomeGrupo(cat))}">${ic(iconeDoGrupo(cat))}</button>`).join('')}</div>`;
    nav.querySelectorAll('.rail-btn').forEach(b => b.addEventListener('click', () => {
      gruposAbertos.add(b.dataset.cat); salvarAbertos();
      definirRecolhida(false);
      nav.querySelector(`[data-cat="${CSS.escape(b.dataset.cat)}"]`)?.scrollIntoView({ block: 'start' });
    }));
    return;
  }

  nav.innerHTML = grupos.map(([cat, arquivos], i) => {
    const aberto = gruposAbertos.has(cat);
    return `
    <section class="nav-group">
      <h2 class="nav-label">
        <button class="nav-group-btn" type="button" data-cat="${escapeHtml(cat)}" aria-expanded="${aberto}" aria-controls="grupo-${i}" title="${escapeHtml(nomeGrupo(cat))}">
          ${ic(iconeDoGrupo(cat))}
          <span class="nav-group-name">${escapeHtml(nomeGrupo(cat))}</span>
          <span class="nav-count" aria-label="${arquivos.length} materiais">${arquivos.length}</span>
          ${ic('chev-down', 'nav-chev')}
        </button>
      </h2>
      <div class="nav-items" id="grupo-${i}" ${aberto ? '' : 'hidden'}>
        ${arquivos.map(f => `
          <a class="nav-link ${f.id === currentFile ? 'active' : ''}" href="#${escapeHtml(f.id)}" data-id="${escapeHtml(f.id)}"
             title="${escapeHtml(f.title || f.label)}" ${f.id === currentFile ? 'aria-current="page"' : ''}>${escapeHtml(f.label)}</a>`).join('')}
      </div>
    </section>`;
  }).join('') || '<p class="nav-vazio">Nenhum material encontrado.</p>';

  nav.querySelectorAll('.nav-group-btn').forEach(b => b.addEventListener('click', () => {
    const cat = b.dataset.cat;
    if (gruposAbertos.has(cat)) gruposAbertos.delete(cat); else gruposAbertos.add(cat);
    salvarAbertos();
    const aberto = gruposAbertos.has(cat);
    b.setAttribute('aria-expanded', String(aberto));
    $(b.getAttribute('aria-controls')).hidden = !aberto;
  }));
  nav.querySelectorAll('.nav-link').forEach(a => a.addEventListener('click', e => {
    e.preventDefault();
    loadFile(a.dataset.id);
    closeMobileMenu();
  }));
  nav.scrollTop = rolagem;
}

function marcarAtivo() {
  const nav = $('nav');
  nav.querySelectorAll('.nav-link').forEach(a => {
    const ativo = a.dataset.id === currentFile;
    a.classList.toggle('active', ativo);
    if (ativo) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current');
  });
  nav.querySelectorAll('.rail-btn').forEach(b => b.classList.toggle('ativo', b.dataset.cat === catAtual()));
  nav.querySelector('.nav-link.active')?.scrollIntoView({ block: 'nearest' });
}

function abrirGrupo(cat) {
  gruposAbertos.add(cat); salvarAbertos();
  if (isCollapsed && desktop.matches) definirRecolhida(false); else renderNav();
  if (!desktop.matches) toggleSidebar(true);
  $('nav').querySelector(`.nav-group-btn[data-cat="${CSS.escape(cat)}"]`)?.scrollIntoView({ block: 'start' });
}

// ========== CARREGAR MATERIAL ==========
function registrarRecente(id) {
  if (id === 'inicio') return;
  let lista; try { lista = JSON.parse(lsGet('recentes', '[]')) || []; } catch (e) { lista = []; }
  lista = [id, ...lista.filter(x => x !== id)].slice(0, 8);
  lsSet('recentes', JSON.stringify(lista));
  lsSet('ultimo', id);
}
async function loadFile(id, opcoes = {}) {
  const file = FILES.find(f => f.id === id);
  if (!file) return;

  currentFile = id;
  if (!opcoes.semHistorico && location.hash.slice(1) !== id) history.pushState(null, '', '#' + id);
  registrarRecente(id);
  $('topbarTitulo').textContent = file.id === 'inicio' ? 'Formação AE' : (file.label || file.title);
  document.title = (file.id === 'inicio' ? '' : (file.title || file.label) + ' · ') + 'Formação AE';

  if (!file.oculto && !gruposAbertos.has(file.cat)) { gruposAbertos.add(file.cat); salvarAbertos(); renderNav(); }
  else marcarAtivo();
  renderCrumbs(file);
  updateFileNav();
  showLoading();
  $('main').scrollTop = 0;

  if (!file.path) { renderContent(file, ''); return; }
  try {
    const res = await fetch(file.path, { cache: 'no-cache' });
    if (!res.ok) throw new Error(res.status + ' ' + res.statusText);
    if (currentFile !== id) return;      // o usuário já foi para outro material
    renderContent(file, await res.text());
  } catch (err) {
    if (currentFile === id) renderError(file, err.message);
  }
}

// ========== MIGALHAS ==========
function renderCrumbs(file) {
  const el = $('crumbs');
  if (file.id === 'inicio') { el.hidden = true; return; }
  el.hidden = false;
  el.innerHTML = `<ol>
    <li><button type="button" data-ir="inicio">Início</button></li>
    <li><button type="button" data-cat="${escapeHtml(file.cat)}">${escapeHtml(nomeGrupo(file.cat))}</button></li>
    <li><span aria-current="page">${escapeHtml(file.label)}</span></li></ol>`;
  el.querySelector('[data-ir]').addEventListener('click', () => loadFile('inicio'));
  el.querySelector('[data-cat]').addEventListener('click', e => abrirGrupo(e.currentTarget.dataset.cat));
}

// ========== ANTERIOR / PRÓXIMO ==========
function updateFileNav() {
  const nav = $('fileNav');
  const lista = visiveis();
  const idx = lista.findIndex(f => f.id === currentFile);
  if (idx === -1) { nav.hidden = true; return; }
  nav.hidden = false;
  const anterior = lista[idx - 1], proximo = lista[idx + 1];
  $('prevTitle').textContent = anterior ? (anterior.title || anterior.label) : '';
  $('nextTitle').textContent = proximo ? (proximo.title || proximo.label) : '';
  $('prevBtn').disabled = !anterior;
  $('nextBtn').disabled = !proximo;
}
function goPrev() { const l = visiveis(), i = l.findIndex(f => f.id === currentFile); if (i > 0) loadFile(l[i - 1].id); }
function goNext() { const l = visiveis(), i = l.findIndex(f => f.id === currentFile); if (i >= 0 && i < l.length - 1) loadFile(l[i + 1].id); }

function showLoading() {
  const content = $('content');
  $('emptyHint').hidden = true;
  content.hidden = false;
  content.innerHTML = '<p class="main-meta" role="status" style="text-align:center;padding:3rem 0">Carregando…</p>';
}

// ========== CONTEÚDO EM MARKDOWN ==========
function renderContent(file, text) {
  const content = $('content');
  $('emptyHint').hidden = true;
  content.hidden = false;

  // Retorno logo no topo: mais abaixo o isMd embrulharia o JSON num <pre>.
  const custom = file.view && VIEWS[file.view];
  if (custom) return custom(file, text);

  const isMd = file.path.endsWith('.md');
  const tmp = document.createElement('div');
  tmp.innerHTML = isMd ? marked.parse(text) : '<pre><code>' + escapeHtml(text) + '</code></pre>';

  // O .md é injetado na página raiz: caminho relativo resolveria contra a raiz e não contra
  // a pasta do material. Reescreve src/href relativos com o diretório do arquivo.
  const dir = file.path.includes('/') && !/^https?:/.test(file.path) ? file.path.replace(/\/[^/]*$/, '/') : '';
  tmp.querySelectorAll('img[src], a[href]').forEach(el => {
    const attr = el.tagName === 'IMG' ? 'src' : 'href';
    const v = el.getAttribute(attr) || '';
    if (dir && v && !/^([a-z]+:|\/|#|\?)/i.test(v)) el.setAttribute(attr, dir + v);
    if (attr === 'href' && /^https?:/i.test(el.getAttribute('href') || '')) { el.target = '_blank'; el.rel = 'noopener'; }
  });

  // O primeiro h1 do arquivo repete o título do cabeçalho da tela.
  const h1 = tmp.querySelector(':scope > h1');
  if (h1 && normalizar(h1.textContent).trim() === normalizar(file.title || '').trim()) h1.remove();

  // Tabela larga rola dentro do próprio contêiner, nunca na página.
  tmp.querySelectorAll('table').forEach(t => {
    const caixa = document.createElement('div');
    caixa.className = 'tabela-rolagem';
    caixa.tabIndex = 0;
    caixa.setAttribute('role', 'region');
    caixa.setAttribute('aria-label', 'Tabela (role para os lados se precisar)');
    t.replaceWith(caixa);
    caixa.appendChild(t);
  });
  // Bloco de código com botão de copiar.
  tmp.querySelectorAll('pre').forEach(p => {
    const caixa = document.createElement('div');
    caixa.className = 'pre-wrap';
    p.replaceWith(caixa);
    caixa.appendChild(p);
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'pre-copiar'; b.textContent = 'Copiar';
    b.setAttribute('aria-label', 'Copiar o bloco de código');
    caixa.appendChild(b);
  });

  content.innerHTML = `
    <header class="main-header">
      <span class="module-badge">${escapeHtml(nomeGrupo(file.cat))}</span>
      <h1 class="main-title">${escapeHtml(file.title || file.label)}</h1>
      <div class="main-meta">${escapeHtml(file.path)} · ${formatBytes(text.length)}</div>
    </header>
    <div class="markdown-body">${tmp.innerHTML}</div>`;

  content.querySelectorAll('.pre-copiar').forEach(b => b.addEventListener('click', async () => {
    const codigo = b.previousElementSibling.textContent;
    try { await navigator.clipboard.writeText(codigo); b.textContent = 'Copiado'; }
    catch (e) { b.textContent = 'Copie à mão'; }
    setTimeout(() => { b.textContent = 'Copiar'; }, 1600);
  }));
  content.querySelectorAll('a[href^="#"]').forEach(a => a.addEventListener('click', e => {
    const alvo = a.getAttribute('href');
    if (alvo.length < 2) return;
    const el = content.querySelector(alvo.replace(/[^\w#-]/g, ''));
    if (el) { e.preventDefault(); el.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
  }));
}

// ========== PALETA DE BUSCA (Ctrl+K ou /) ==========
let paletaAberta = false, paletaSel = 0, paletaOpcoes = [], focoAntesDaPaleta = null;

function pontuar(f, tokens) {
  const label = normalizar(f.label), titulo = normalizar(f.title), cat = normalizar(f.cat);
  const todo = label + ' ' + titulo + ' ' + cat;
  if (!tokens.every(t => todo.includes(t))) return 0;
  return tokens.reduce((s, t) => s + (label.startsWith(t) ? 4 : label.includes(t) ? 3 : titulo.includes(t) ? 2 : 1), 0);
}
function realcar(texto, tokens) {
  const norm = normalizar(texto);
  const marcas = new Array(texto.length).fill(false);
  tokens.forEach(t => { let i = norm.indexOf(t); while (i !== -1) { for (let k = i; k < i + t.length; k++) marcas[k] = true; i = norm.indexOf(t, i + t.length); } });
  let saida = '', aberto = false;
  [...texto].forEach((ch, i) => {
    if (marcas[i] && !aberto) { saida += '<mark>'; aberto = true; }
    if (!marcas[i] && aberto) { saida += '</mark>'; aberto = false; }
    saida += escapeHtml(ch);
  });
  return saida + (aberto ? '</mark>' : '');
}
function opcoesDaPaleta(q) {
  const lista = visiveis();
  const tokens = normalizar(q).split(/\s+/).filter(Boolean);
  if (!tokens.length) {
    let recentes; try { recentes = JSON.parse(lsGet('recentes', '[]')) || []; } catch (e) { recentes = []; }
    const rec = recentes.map(id => lista.find(f => f.id === id)).filter(Boolean).slice(0, 6);
    const atalhos = ['grafo', 'biblioteca', 'desafio', 'kit_visual'].map(id => lista.find(f => f.id === id)).filter(Boolean);
    return [{ grupo: 'Recentes', itens: rec }, { grupo: 'Atalhos', itens: atalhos.filter(a => !rec.includes(a)) }].filter(g => g.itens.length);
  }
  const pontuados = lista.map(f => ({ f, p: pontuar(f, tokens) })).filter(x => x.p > 0);
  const porCat = new Map();
  pontuados.forEach(x => { if (!porCat.has(x.f.cat)) porCat.set(x.f.cat, []); porCat.get(x.f.cat).push(x); });
  return [...porCat.entries()]
    .map(([cat, xs]) => ({ grupo: nomeGrupo(cat), max: Math.max(...xs.map(x => x.p)), itens: xs.sort((a, b) => b.p - a.p).slice(0, 8).map(x => x.f) }))
    .sort((a, b) => b.max - a.max).slice(0, 6);
}
function renderPaleta() {
  const q = $('paletaInput').value;
  const tokens = normalizar(q).split(/\s+/).filter(Boolean);
  const grupos = opcoesDaPaleta(q);
  paletaOpcoes = grupos.flatMap(g => g.itens);
  paletaSel = Math.min(paletaSel, Math.max(0, paletaOpcoes.length - 1));
  let n = 0;
  $('paletaLista').innerHTML = paletaOpcoes.length ? grupos.map(g => `
    <li role="presentation" class="paleta-grupo">${escapeHtml(g.grupo)}</li>
    ${g.itens.map(f => { const i = n++; return `
    <li role="option" class="paleta-item" id="po-${i}" data-i="${i}" aria-selected="${i === paletaSel}">
      ${ic(iconeDoGrupo(f.cat))}<span><strong>${realcar(f.label, tokens)}</strong><small>${realcar(f.title && f.title !== f.label ? f.title : nomeGrupo(f.cat), tokens)}</small></span>
    </li>`; }).join('')}`).join('')
    : `<li class="paleta-vazio" role="presentation">Nada encontrado para “${escapeHtml(q)}”. Tente outra palavra ou parte do nome do arquivo.</li>`;
  $('paletaInput').setAttribute('aria-activedescendant', paletaOpcoes.length ? 'po-' + paletaSel : '');
  $('paletaLista').querySelectorAll('.paleta-item').forEach(li => {
    li.addEventListener('click', () => escolherNaPaleta(+li.dataset.i));
    li.addEventListener('mousemove', () => { if (paletaSel !== +li.dataset.i) { paletaSel = +li.dataset.i; marcarSelecaoDaPaleta(false); } });
  });
}
function marcarSelecaoDaPaleta(rolar = true) {
  $('paletaLista').querySelectorAll('.paleta-item').forEach(li => li.setAttribute('aria-selected', String(+li.dataset.i === paletaSel)));
  $('paletaInput').setAttribute('aria-activedescendant', 'po-' + paletaSel);
  if (rolar) $('po-' + paletaSel)?.scrollIntoView({ block: 'nearest' });
}
function abrirPaleta() {
  if (paletaAberta) return;
  if (sidebarOpen) toggleSidebar(false);
  paletaAberta = true; paletaSel = 0;
  focoAntesDaPaleta = document.activeElement;
  $('shell').inert = true; $('sidebar').inert = true;
  $('paleta').hidden = false;
  $('paletaInput').value = '';
  renderPaleta();
  $('paletaInput').focus();
}
function fecharPaleta() {
  if (!paletaAberta) return;
  paletaAberta = false;
  $('paleta').hidden = true;
  $('shell').inert = false; $('sidebar').inert = false;
  if (focoAntesDaPaleta && document.contains(focoAntesDaPaleta)) focoAntesDaPaleta.focus();
}
function escolherNaPaleta(i) {
  const f = paletaOpcoes[i];
  if (!f) return;
  fecharPaleta();
  loadFile(f.id);
}
function initPaleta() {
  const input = $('paletaInput');
  input.addEventListener('input', () => { paletaSel = 0; renderPaleta(); });
  input.addEventListener('keydown', e => {
    if (e.key === 'ArrowDown') { e.preventDefault(); if (paletaOpcoes.length) { paletaSel = (paletaSel + 1) % paletaOpcoes.length; marcarSelecaoDaPaleta(); } }
    else if (e.key === 'ArrowUp') { e.preventDefault(); if (paletaOpcoes.length) { paletaSel = (paletaSel - 1 + paletaOpcoes.length) % paletaOpcoes.length; marcarSelecaoDaPaleta(); } }
    else if (e.key === 'Enter') { e.preventDefault(); escolherNaPaleta(paletaSel); }
    else if (e.key === 'Tab') { e.preventDefault(); }
  });
  $('paleta').addEventListener('mousedown', e => { if (e.target === $('paleta')) fecharPaleta(); });
  $('paletaFechar').addEventListener('click', fecharPaleta);
}

