            <div class="kit-cores">${st.paleta.map((c, i) => `<input type="color" data-paleta="${i}" value="${c}" aria-label="Cor ${i + 1}">`).join('')}</div>
            <div class="kit-linha"><label for="kBom">Resultado bom</label><input type="color" id="kBom" value="${st.bom}"></div>
            <div class="kit-linha"><label for="kRuim">Resultado ruim</label><input type="color" id="kRuim" value="${st.ruim}"></div>
          </fieldset>
        </form>
        <div>
          <div class="kit-preview" id="kitPreview"></div>
          <div class="kit-contraste" id="kitContraste"></div>
          <div class="kit-acoes">
            <button class="bib-btn" type="button" id="kitTema">Baixar tema (.json)</button>
            <button class="bib-btn" type="button" id="kitFundo">Baixar fundo (.svg)</button>
          </div>
        </div>
      </div>
      <p class="pn-rodape">Kit visual por ${AUTORIA}. Tema: Power BI Desktop › Exibição › Temas › Procurar temas. Fundo: Formatar página › Plano de fundo da tela › imagem, ajuste "Ajustar".</p>
    </div>`;

  const $ = id => document.getElementById(id);
  function ler() {
    st.nome = $('kNome').value.trim() || 'Meu tema';
    st.primaria = $('kPrim').value; st.modo = $('kModo').value; st.navegacao = $('kNav').value;
    st.filtros = $('kFiltros').checked; st.borda = $('kBorda').checked;
    st.cards = Math.min(regras.limites.cards_max, Math.max(regras.limites.cards_min, +$('kCards').value || 4));
    st.colunas_graficos = +$('kCols').value;
    st.linhas_graficos = Math.min(regras.limites.linhas_graficos_max, Math.max(1, +$('kLinhas').value || 1));
    st.raio = +$('kRaio').value;
    st.paleta = [...document.querySelectorAll('[data-paleta]')].map(i => i.value);
    st.bom = $('kBom').value; st.ruim = $('kRuim').value;
  }

  function checar() {
    const m = regras.modos[st.modo];
    const pares = [
      ['Texto sobre o cartão', m.texto, m.cartao, regras.contraste.texto],
      ['Texto suave sobre o cartão', m.texto_suave, m.cartao, regras.contraste.texto],
      ['Título sobre a cor principal', kitTextoSobre(st.primaria), st.primaria, regras.contraste.texto],
      ...st.paleta.map((c, i) => [`Cor ${i + 1} do gráfico`, c, m.cartao, regras.contraste.grafico]),
      ['Resultado bom', st.bom, m.cartao, regras.contraste.grafico],
      ['Resultado ruim', st.ruim, m.cartao, regras.contraste.grafico],
    ].map(([rot, a, b, min]) => ({ rot, razao: kitContraste(a, b), min }));
    const falhas = pares.filter(p => p.razao < p.min);
    $('kitContraste').innerHTML = `<b>${falhas.length ? `${falhas.length} par(es) abaixo do mínimo — ajuste antes de baixar` : 'Contraste aprovado em todos os pares'}</b>
      <ul>${pares.map(p => `<li><span>${p.rot}</span><span class="${p.razao >= p.min ? 'kit-ok' : 'kit-falha'}">${p.razao.toFixed(2)} (mín. ${p.min})</span></li>`).join('')}</ul>`;
    $('kitTema').disabled = $('kitFundo').disabled = falhas.length > 0;
  }

  function desenhar() { ler(); $('kitPreview').innerHTML = kitSvg(regras, st, true); checar(); }

  function baixar(nome, conteudo, tipo) {
    const url = URL.createObjectURL(new Blob([conteudo], { type: tipo }));
    const a = Object.assign(document.createElement('a'), { href: url, download: nome });
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }
  const arquivo = () => st.nome.normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^A-Za-z0-9]+/g, '-').replace(/^-|-$/g, '').toLowerCase() || 'tema';

  $('kitForm').addEventListener('input', desenhar);
  $('kitForm').addEventListener('change', desenhar);
  $('kLogo').addEventListener('change', e => {
    const f = e.target.files[0];
    if (!f) { st.logo = null; return desenhar(); }
    const leitor = new FileReader();
    leitor.onload = () => { st.logo = leitor.result; desenhar(); };
    leitor.readAsDataURL(f);
  });
  $('kitTema').addEventListener('click', () => baixar(`tema-${arquivo()}.json`, JSON.stringify(kitTema(regras, st), null, 2), 'application/json'));
  $('kitFundo').addEventListener('click', () => baixar(`fundo-${arquivo()}.svg`, kitSvg(regras, st, false), 'image/svg+xml'));
  desenhar();
}

// Mesma geometria no preview e no fundo exportado; o fundo sai sem texto nem dado.
function kitLayout(r, st) {
  const W = r.canvas.largura, H = r.canvas.altura, M = r.grade.margem, G = r.grade.gutter, A = r.alturas;
  const caixas = [];
  const cab = { x: 0, y: 0, w: W, h: A.cabecalho, papel: 'cabecalho' };
  let x0 = M, y = A.cabecalho + M;
  let nav = null;
  if (st.navegacao === 'lateral') {
    nav = { x: 0, y: A.cabecalho, w: r.navegacao_lateral.largura, h: H - A.cabecalho, papel: 'nav' };
    x0 = r.navegacao_lateral.largura + M;
  } else if (st.navegacao === 'topo') {
    nav = { x: 0, y: A.cabecalho, w: W, h: A.navegacao_topo, papel: 'nav' };
    y += A.navegacao_topo;
  }
  const largura = W - x0 - M;
  if (st.filtros) { caixas.push({ x: x0, y, w: largura, h: A.filtros, papel: 'filtros' }); y += A.filtros + G; }
  const wc = (largura - G * (st.cards - 1)) / st.cards;
  for (let i = 0; i < st.cards; i++) caixas.push({ x: x0 + i * (wc + G), y, w: wc, h: A.cards, papel: 'card', i });
  y += A.cards + G;
  const altRest = H - M - y, hg = (altRest - G * (st.linhas_graficos - 1)) / st.linhas_graficos;
  const wg = (largura - G * (st.colunas_graficos - 1)) / st.colunas_graficos;
  let k = 0;
  for (let l = 0; l < st.linhas_graficos; l++)
    for (let c = 0; c < st.colunas_graficos; c++)
      caixas.push({ x: x0 + c * (wg + G), y: y + l * (hg + G), w: wg, h: hg, papel: 'grafico', i: k++ });
  return { W, H, cab, nav, caixas };
}

function kitSvg(r, st, preview) {
  const m = r.modos[st.modo], L = kitLayout(r, st), f = n => n.toFixed(1);
  const borda = st.borda ? ` stroke="${m.borda}" stroke-width="1"` : '';
  const txtCab = kitTextoSobre(st.primaria);
  const partes = [`<rect width="${L.W}" height="${L.H}" fill="${m.pagina}"/>`,
    `<rect x="0" y="0" width="${L.W}" height="${L.cab.h}" fill="${st.primaria}"/>`];
  if (st.logo) partes.push(`<image href="${st.logo}" x="${r.grade.margem}" y="12" height="${L.cab.h - 24}" width="160" preserveAspectRatio="xMinYMid meet"/>`);
  if (preview) partes.push(`<text x="${st.logo ? 200 : r.grade.margem}" y="${L.cab.h / 2 + 6}" fill="${txtCab}" font-family="Segoe UI, Arial" font-size="18" font-weight="600">${escapeHtml(st.nome)}</text>`);
  if (L.nav) {
    partes.push(`<rect x="${L.nav.x}" y="${L.nav.y}" width="${L.nav.w}" height="${L.nav.h}" fill="${m.cartao}"${borda}/>`);
    if (preview) for (let i = 0; i < 4; i++) {
      const lateral = st.navegacao === 'lateral';
      const x = lateral ? L.nav.w / 2 - 12 : r.grade.margem + i * 120, y = lateral ? L.nav.y + 24 + i * 52 : L.nav.y + 10;
      partes.push(`<rect x="${x}" y="${y}" width="${lateral ? 24 : 100}" height="${lateral ? 24 : 20}" rx="4" fill="${i === 0 ? st.primaria : m.borda}"/>`);
    }
  }
  for (const c of L.caixas) {
    partes.push(`<rect x="${f(c.x)}" y="${f(c.y)}" width="${f(c.w)}" height="${f(c.h)}" rx="${st.raio}" fill="${m.cartao}"${borda}/>`);
    if (!preview) continue;
    if (c.papel === 'filtros') for (let i = 0; i < 4; i++)
      partes.push(`<rect x="${f(c.x + 16 + i * 150)}" y="${f(c.y + 16)}" width="134" height="24" rx="4" fill="none" stroke="${m.borda}"/>`);
    if (c.papel === 'card') {
      const bom = c.i % 2 === 0;
      partes.push(`<text x="${f(c.x + 16)}" y="${f(c.y + 30)}" fill="${m.texto_suave}" font-family="Segoe UI, Arial" font-size="12">KPI ${c.i + 1}</text>`,
        `<text x="${f(c.x + 16)}" y="${f(c.y + 64)}" fill="${m.texto}" font-family="Segoe UI, Arial" font-size="26" font-weight="600">${(12 + c.i * 7).toFixed(1)} mi</text>`,
        `<text x="${f(c.x + 16)}" y="${f(c.y + 84)}" fill="${bom ? st.bom : st.ruim}" font-family="Segoe UI, Arial" font-size="12">${bom ? '▲ 4,2%' : '▼ 1,8%'}</text>`);
    }
    if (c.papel === 'grafico') {
      const n = 6, base = c.y + c.h - 20, alt = c.h - 60, bw = (c.w - 40) / n;
      partes.push(`<text x="${f(c.x + 16)}" y="${f(c.y + 24)}" fill="${m.texto}" font-family="Segoe UI, Arial" font-size="13" font-weight="600">Gráfico ${c.i + 1}</text>`);
      for (let b = 0; b < n; b++) {
        const h = alt * (0.35 + 0.6 * Math.abs(Math.sin((b + 1) * (c.i + 2))));
        partes.push(`<rect x="${f(c.x + 20 + b * bw + bw * 0.15)}" y="${f(base - h)}" width="${f(bw * 0.7)}" height="${f(h)}" rx="2" fill="${st.paleta[b % st.paleta.length]}"/>`);
      }
    }
  }
  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${L.W} ${L.H}" width="${L.W}" height="${L.H}">${partes.join('')}</svg>`;
}

function kitTema(r, st) {
  const m = r.modos[st.modo];
  const solido = cor => ({ solid: { color: cor } });
  return {
    name: st.nome,
    dataColors: st.paleta,
    background: m.cartao,
    foreground: m.texto,
    tableAccent: st.primaria,
    good: st.bom, bad: st.ruim, neutral: r.padrao.neutro,
    textClasses: {
      title: { fontFace: r.fontes.titulo, fontSize: 12, color: m.texto },
      header: { fontFace: r.fontes.titulo, fontSize: 12, color: m.texto },
      label: { fontFace: r.fontes.texto, fontSize: 10, color: m.texto_suave },
      callout: { fontFace: r.fontes.numero, fontSize: 28, color: m.texto },
    },
    visualStyles: {
      '*': { '*': {
        background: [{ show: true, color: solido(m.cartao), transparency: 0 }],
        border: [{ show: st.borda, color: solido(m.borda), radius: st.raio }],
        title: [{ fontColor: solido(m.texto) }],
      } },
      page: { '*': {
        background: [{ color: solido(m.pagina), transparency: 0 }],
        outspace: [{ color: solido(m.pagina) }],
      } },
    },
  };
}

