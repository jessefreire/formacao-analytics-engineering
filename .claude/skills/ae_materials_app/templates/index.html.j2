.content blockquote > :first-child { margin-top: 0; } .content blockquote > :last-child { margin-bottom: 0; }
.tabela-rolagem { max-width: var(--measure-wide); margin: var(--sp-6) 0; overflow-x: auto; overscroll-behavior-x: contain; border: 1px solid var(--border); border-radius: var(--radius); }
.tabela-rolagem:focus-visible { outline-offset: 0; }
.content table { width: 100%; min-width: 34rem; border-collapse: collapse; font-size: var(--fs-sm); }
.content th, .content td { padding: var(--sp-2) var(--sp-3); text-align: left; vertical-align: top; border-bottom: 1px solid var(--border); }
.content tr:last-child td { border-bottom: 0; }
