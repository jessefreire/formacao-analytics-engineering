@media (min-width: 640px) { .trilho { margin-inline: 0; padding-inline: 0; flex-wrap: wrap; overflow: visible; } }

/* ========== CONTEÚDO EM MARKDOWN ========== */
.markdown-body { line-height: 1.7; overflow-wrap: break-word; min-width: 0; }
