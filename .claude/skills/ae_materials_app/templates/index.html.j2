// ========== TELA DO DESAFIO ==========
const DSF_KEY = 'ae_desafio_v1';
const DSF_ESTADOS = [
  { v: 'todo', rot: 'Nao comecado' },
  { v: 'wip',  rot: 'Em andamento' },
  { v: 'done', rot: 'Pronto' },
];

// localStorage lanca em modo privado e por cota. Um throw aqui mataria o toggle
// em silencio, entao os dois lados sao tolerantes a falha.
function dsfLer() {
  try {
    const cru = JSON.parse(localStorage.getItem(DSF_KEY) || '{}');
    const ok = {};
    const validos = DSF_ESTADOS.map(e => e.v);
    for (const [k, v] of Object.entries(cru)) ok[k] = validos.includes(v) ? v : 'todo';
    return ok;
  } catch (e) { return {}; }
}
function dsfGravar(st) {
  try { localStorage.setItem(DSF_KEY, JSON.stringify(st)); return true; }
  catch (e) { return false; }
}

function renderDesafio(file, text) {
  const content = document.getElementById('content');
  let itens;
  try {
    itens = JSON.parse(text);
    if (!Array.isArray(itens)) throw new Error('esperava uma lista de entregaveis');
  } catch (e) {
    return renderError(file, 'JSON invalido em ' + file.path + ': ' + e.message);
  }

  // Ids gravados que nao existem mais no JSON sao ignorados, nunca apagados:
  // um rename revertido volta a funcionar. E o denominador vem do JSON, nunca
  // das chaves gravadas.
  const st = dsfLer();
  const estado = id => st[id] || 'todo';
  const obrig = itens.filter(i => !i.opcional);
  const prontos = obrig.filter(i => estado(i.id) === 'done').length;
  const pct = obrig.length ? Math.round((prontos / obrig.length) * 100) : 0;

  const trava = it => (it.depende_de || [])
    .filter(d => estado(d) !== 'done')
    .map(d => (itens.find(x => x.id === d) || {}).titulo || d);

  content.innerHTML = `
    <header class="main-header">
      <h1 class="main-title">${escapeHtml(file.title || file.label)}</h1>
      <div class="dsf-resumo">
        <div class="dsf-barra" role="progressbar" aria-valuenow="${pct}" aria-valuemin="0" aria-valuemax="100"
             aria-label="Progresso dos entregaveis obrigatorios"><span style="width:${pct}%"></span></div>
        <span class="dsf-contagem">${prontos} de ${obrig.length} obrigatorios &middot; ${pct}%</span>
        <span class="dsf-acoes">
          <button class="dsf-acao" id="dsfCopiar" type="button">Copiar progresso</button>
          <button class="dsf-acao" id="dsfImportar" type="button">Importar</button>
        </span>
      </div>
    </header>
    <div class="dsf-lista">
      ${itens.map(it => {
        const s = estado(it.id);
        const pend = trava(it);
        return `
        <div class="dsf-item" data-st="${s}" data-id="${escapeHtml(it.id)}">
          <span class="dsf-etapa">${escapeHtml(String(it.etapa ?? '-'))}</span>
          <div class="dsf-cab">
            <span class="dsf-titulo">${escapeHtml(it.titulo || it.id)}</span>
            ${it.opcional ? '<span class="dsf-opcional">opcional</span>' : ''}
          </div>
          <p class="dsf-oque">${escapeHtml(it.oque || '')}</p>
          <div class="dsf-meta">${escapeHtml(it.formato || '')}${
            pend.length ? ' &middot; <span class="dsf-trava">espera: ' + escapeHtml(pend.join(', ')) + '</span>' : ''
          }</div>
          <div class="dsf-est" role="group" aria-label="Estado de ${escapeHtml(it.titulo || it.id)}">
            ${DSF_ESTADOS.map(e => `
              <button class="dsf-bt" type="button" data-v="${e.v}"
                      aria-pressed="${s === e.v}">${e.rot}</button>`).join('')}
          </div>
        </div>`;
      }).join('')}
    </div>
    <p class="dsf-aviso">O progresso fica no navegador (localStorage), nao no git &mdash; e por origem,
      entao localhost e uma versao publicada nao compartilham marcacao. Use "Copiar progresso"
      pra guardar.</p>
  `;

  content.querySelectorAll('.dsf-item').forEach(card => {
    card.querySelectorAll('.dsf-bt').forEach(bt => {
      bt.addEventListener('click', () => {
        const atual = dsfLer();
        atual[card.dataset.id] = bt.dataset.v;
        if (!dsfGravar(atual)) {
          alert('Nao foi possivel gravar o progresso neste navegador (modo privado ou cota cheia).');
          return;
        }
        renderDesafio(file, text);
      });
    });
  });

  document.getElementById('dsfCopiar').addEventListener('click', async (ev) => {
    const bt = ev.currentTarget;
    const txt = JSON.stringify(dsfLer(), null, 2);
    try {
      await navigator.clipboard.writeText(txt);
      bt.textContent = 'Copiado';
      setTimeout(() => { bt.textContent = 'Copiar progresso'; }, 1500);
    } catch (e) {
      // Fora de contexto seguro (aberto por IP na rede) a Clipboard API nao existe.
      window.prompt('Copie o progresso:', txt);
    }
  });

  document.getElementById('dsfImportar').addEventListener('click', () => {
    const cru = window.prompt('Cole o JSON de progresso:');
    if (!cru) return;
    try {
      const novo = JSON.parse(cru);
      if (typeof novo !== 'object' || novo === null || Array.isArray(novo)) {
        throw new Error('esperava um objeto');
      }
      if (!dsfGravar(novo)) throw new Error('nao foi possivel gravar neste navegador');
      renderDesafio(file, text);
    } catch (e) {
      alert('Nao importei: ' + e.message);
    }
  });
}

// Tabela de despacho: uma tela nova custa uma linha aqui, nada em renderContent.
// ========== TELA DO GRAFO ==========
const GRF_LIB = 'https://cdn.jsdelivr.net/npm/cytoscape@3.30.2/dist/cytoscape.min.js';
let grfCarregando = null;
function grfBiblioteca() {
  if (window.cytoscape) return Promise.resolve();
  if (!grfCarregando) grfCarregando = new Promise((ok, falha) => {
    const s = document.createElement('script');
    s.src = GRF_LIB; s.onload = ok; s.onerror = () => falha(new Error('não carregou a biblioteca do grafo (sem internet?)'));
    document.head.appendChild(s);
  });
  return grfCarregando;
}

function renderGrafo(file, text) {
  const dados = JSON.parse(text);
  const content = document.getElementById('content');
  const contagem = {};
  dados.nos.forEach(n => { contagem[n.tipo] = (contagem[n.tipo] || 0) + 1; });

  content.innerHTML = `
    <div class="grf">
      <header class="main-header">
        <h1 class="main-title">${escapeHtml(file.title)}</h1>
        <div class="main-meta">${dados.nos.length} nós · ${dados.ligacoes.length} ligações</div>
      </header>
      <div class="grf-barra">
        <div class="trilho">${Object.entries(dados.tipos).map(([t, d]) => `
          <button class="grf-tipo" type="button" data-tipo="${t}" aria-pressed="true">
            <span class="grf-ponto" style="background:var(--c-${t})"></span>${escapeHtml(d.rotulo)} · ${contagem[t] || 0}
          </button>`).join('')}</div>
        <input class="grf-busca" id="grfBusca" type="search" placeholder="Buscar nó…" aria-label="Buscar nó no grafo">
      </div>
      <div class="grf-tela" id="grfTela" role="img" aria-label="Grafo da formação"></div>
      <p class="grf-dica">Passe o mouse para destacar as ligações · clique num nó para abrir o material · arraste e role para navegar.</p>
    </div>`;

  grfBiblioteca().then(() => grfDesenhar(dados)).catch(e => renderError(file, e.message));
}

// Cores de canvas vêm dos tokens: o tema escuro troca as variáveis e o grafo redesenha.
const token = nome => getComputedStyle(document.documentElement).getPropertyValue(nome).trim();

function grfDesenhar(dados) {
  const css = getComputedStyle(document.documentElement);
  const fg = css.getPropertyValue('--fg').trim() || '#0d0e1c';
  const borda = css.getPropertyValue('--border-strong').trim() || '#c9c9d6';
  const tamanho = { modulo: 34, etapa: 30, ferramenta: 28, skill: 22, material: 12 };

  const cy = cytoscape({
    container: document.getElementById('grfTela'),
    elements: [
      ...dados.nos.map(n => ({ data: { ...n, cor: token('--c-' + n.tipo) || token('--accent'), tam: tamanho[n.tipo] || 16 } })),
      ...dados.ligacoes.map(([a, b], i) => ({ data: { id: 'l' + i, source: a, target: b } })),
    ],
    style: [
      { selector: 'node', style: {
        'background-color': 'data(cor)', width: 'data(tam)', height: 'data(tam)',
        label: 'data(rotulo)', color: fg, 'font-size': 14, 'text-valign': 'bottom', 'text-margin-y': 4,
        'text-wrap': 'ellipsis', 'text-max-width': 160, 'min-zoomed-font-size': 3,
        'text-outline-color': css.getPropertyValue('--card').trim() || '#fff', 'text-outline-width': 2 } },
      // Material tem nome longo e sao 78: so aparece ao aproximar, senao vira borrao.
      { selector: 'node[tipo = "material"]', style: { 'font-size': 9, 'min-zoomed-font-size': 9 } },
      { selector: 'node[?nova]', style: { 'border-width': 3, 'border-color': token('--warn') } },
      { selector: 'edge', style: { width: 1, 'line-color': borda, 'curve-style': 'haystack', opacity: .7 } },
      { selector: '.apagado', style: { opacity: .12 } },
      { selector: '.escondido', style: { display: 'none' } },
      { selector: 'node.foco', style: { 'border-width': 3, 'border-color': fg } },
    ],
    layout: { name: 'cose', animate: false, nodeRepulsion: 9000, idealEdgeLength: 70, gravity: 0.6, randomize: true },
    wheelSensitivity: 0.25,
  });

  cy.on('mouseover', 'node', e => {
    const viz = e.target.closedNeighborhood();
    cy.elements().not(viz).addClass('apagado');
  });
  cy.on('mouseout', 'node', () => cy.elements().removeClass('apagado'));
  cy.on('tap', 'node', e => { const f = e.target.data('arquivo'); if (f) loadFile(f); });

  document.querySelectorAll('.grf-tipo').forEach(b => b.addEventListener('click', () => {
    const ligado = b.getAttribute('aria-pressed') !== 'true';
    b.setAttribute('aria-pressed', String(ligado));
    cy.nodes(`[tipo = "${b.dataset.tipo}"]`).toggleClass('escondido', !ligado);
  }));

  document.getElementById('grfBusca').addEventListener('input', e => {
    const q = e.target.value.trim().toLowerCase();
    cy.nodes().removeClass('foco');
    if (!q) return;
    const achados = cy.nodes().filter(n => (n.data('rotulo') || '').toLowerCase().includes(q));
    achados.addClass('foco');
    if (achados.length) cy.animate({ fit: { eles: achados.closedNeighborhood(), padding: 60 }, duration: 350 });
  });
}

// ========== TELA DA BIBLIOTECA DE SKILLS ==========
const AUTORIA = 'Jessé Freire · Indicium AI';

function renderBiblioteca(file, text) {
  const skills = JSON.parse(text);
  const content = document.getElementById('content');
  const origens = [...new Set(skills.map(s => s.origem))];
  let filtro = 'todas';

  content.innerHTML = `
    <div class="painel">
      <header class="main-header">
        <h1 class="main-title">${escapeHtml(file.title)}</h1>
        <div class="main-meta">${skills.length} skills · instale copiando o comando e rodando na raiz do repositório</div>
      </header>
      <div class="pn-barra">
        <div class="trilho">${['todas', ...origens].map(o => `<button class="pn-chip" type="button" data-origem="${escapeHtml(o)}" aria-pressed="${o === 'todas'}">${escapeHtml({ todas: 'Todas', curso: 'Do curso', 'formação': 'Criadas na formação' }[o] || o)}</button>`).join('')}</div>
        <input class="pn-busca" id="bibBusca" type="search" placeholder="Buscar skill…" aria-label="Buscar skill">
      </div>
      <div class="bib-grade" id="bibGrade"></div>
      <p class="pn-rodape">Skills de ${AUTORIA}.</p>
    </div>`;

  const grade = document.getElementById('bibGrade');
  const busca = document.getElementById('bibBusca');

  function desenhar() {
    const q = busca.value.trim().toLowerCase();
    const lista = skills.filter(s => (filtro === 'todas' || s.origem === filtro)
      && (!q || (s.nome + ' ' + s.descricao + ' ' + s.gatilhos.join(' ')).toLowerCase().includes(q)));
    grade.innerHTML = lista.map(s => `
      <article class="bib-card">
        <div class="bib-topo"><span class="bib-nome">${escapeHtml(s.nome)}</span><span class="bib-origem">${escapeHtml(s.origem)}</span></div>
        <p class="bib-desc" title="${escapeHtml(s.descricao)}">${escapeHtml(s.descricao)}</p>
        ${s.gatilhos.length ? `<div class="bib-gatilhos">${s.gatilhos.map(g => `<span class="bib-gatilho">${escapeHtml(g)}</span>`).join('')}</div>` : ''}
        <div class="bib-acoes">
          <button class="bib-btn" type="button" data-copiar="${escapeHtml(s.instalar.powershell)}">Copiar (PowerShell)</button>
          <button class="bib-btn" type="button" data-copiar="${escapeHtml(s.instalar.bash)}">Copiar (bash)</button>
          ${s.arquivo ? `<button class="bib-btn" type="button" data-abrir="${escapeHtml(s.arquivo)}">Abrir SKILL.md</button>` : ''}
        </div>
      </article>`).join('') || '<p class="bib-desc">Nenhuma skill encontrada.</p>';

    grade.querySelectorAll('[data-copiar]').forEach(b => b.addEventListener('click', async () => {
      const original = b.textContent;
      try { await navigator.clipboard.writeText(b.dataset.copiar); b.textContent = 'Copiado ✓'; }
      catch { b.textContent = 'Copie manualmente'; }
      setTimeout(() => { b.textContent = original; }, 1600);
    }));
    grade.querySelectorAll('[data-abrir]').forEach(b => b.addEventListener('click', () => loadFile(b.dataset.abrir)));
  }

  content.querySelectorAll('[data-origem]').forEach(b => b.addEventListener('click', () => {
    filtro = b.dataset.origem;
    content.querySelectorAll('[data-origem]').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
    desenhar();
  }));
  busca.addEventListener('input', desenhar);
  desenhar();
}

// ========== TELA DO RAIO-X ==========
const RX_SEV = { critico: { rot: 'Crítico', cor: 'var(--bad)' }, medio: { rot: 'Médio', cor: 'var(--warn)' }, leve: { rot: 'Leve', cor: 'var(--neutral)' } };

function rxCorNota(n) { return n >= 85 ? 'var(--ok-anel)' : n >= 65 ? 'var(--warn-anel)' : 'var(--bad-anel)'; }
function rxAnel(n) {
  const c = 2 * Math.PI * 44;
  return `<svg viewBox="0 0 100 100" aria-hidden="true"><circle class="anel-fundo" cx="50" cy="50" r="44" fill="none" stroke-width="8"/><circle class="anel" cx="50" cy="50" r="44" fill="none" stroke-width="8" stroke-dasharray="${c.toFixed(2)}" stroke-dashoffset="${(c * (1 - n / 100)).toFixed(2)}"/></svg>`;
}

function renderRaioX(file, text) {
  const d = JSON.parse(text);
  const content = document.getElementById('content');
  const r = d.resumo;
  const tipos = Object.entries(r.por_tipo).map(([t, n]) => `${n} ${t}`).join(' · ');

  content.innerHTML = `
    <div class="painel">
      <header class="main-header">
        <h1 class="main-title">${escapeHtml(file.title)}</h1>
        <div class="main-meta">Gerado em ${escapeHtml(d.gerado_em.replace('T', ' '))} · ${escapeHtml(tipos)}</div>
      </header>
      <div class="rx-topo">
        <div class="rx-nota" style="--rx-cor:${rxCorNota(d.nota)}" role="img" aria-label="Nota ${d.nota} de 100">${rxAnel(d.nota)}<div><b>${d.nota}</b><span>de 100</span></div></div>
        <div class="rx-numeros">
          ${[['tabelas', r.tabelas], ['colunas', r.colunas], ['medidas', r.medidas], ['relacionamentos', r.relacionamentos]]
            .map(([k, v]) => `<div class="rx-num"><b>${v}</b><span>${k}</span></div>`).join('')}
          ${Object.entries(RX_SEV).map(([s, x]) => `<div class="rx-num"><b style="color:${x.cor}">${d.contagem[s] || 0}</b><span>${x.rot.toLowerCase()}</span></div>`).join('')}
        </div>
      </div>
      <div class="rx-abas" role="tablist">
        ${['Achados', 'Medidas', 'Tabelas', 'Dependências'].map((a, i) => `<button class="rx-aba" role="tab" data-aba="${i}" aria-selected="${i === 0}">${a}</button>`).join('')}
      </div>
      <div id="rxCorpo"></div>
      <p class="pn-rodape">Raio-X por ${AUTORIA} · nota = 100 − (${d.pesos.critico}·crítico + ${d.pesos.medio}·médio + ${d.pesos.leve}·leve), cada check contando no máximo ${d.limite_repeticao} vezes${r.relatorio_lido ? '' : ' · relatório não encontrado: medidas órfãs não avaliadas'}.</p>
    </div>`;

  const corpo = document.getElementById('rxCorpo');
  const abas = [rxAchados, rxMedidas, rxTabelas, rxDependencias];
  content.querySelectorAll('.rx-aba').forEach(b => b.addEventListener('click', () => {
    content.querySelectorAll('.rx-aba').forEach(x => x.setAttribute('aria-selected', String(x === b)));
    abas[+b.dataset.aba](corpo, d);
  }));
  rxAchados(corpo, d);
}

function rxAchados(corpo, d) {
  let filtro = 'todos';
  corpo.innerHTML = `
    <div class="pn-barra"><div class="trilho">
      ${['todos', ...Object.keys(RX_SEV)].map(s => `<button class="pn-chip" type="button" data-sev="${s}" aria-pressed="${s === 'todos'}">${s === 'todos' ? 'Todos' : RX_SEV[s].rot} · ${s === 'todos' ? d.achados.length : (d.contagem[s] || 0)}</button>`).join('')}
    </div></div>
    <div id="rxLista"></div>`;
  const lista = corpo.querySelector('#rxLista');
  function desenhar() {
    const itens = d.achados.filter(a => filtro === 'todos' || a.severidade === filtro);
    lista.innerHTML = itens.map(a => `
      <article class="rx-achado">
        <span class="rx-sev ${a.severidade}">${RX_SEV[a.severidade].rot}</span>
        <h3>${escapeHtml(a.titulo)}</h3>
        <div class="rx-onde">${escapeHtml(a.onde)}</div>
        <p><b>Por que importa:</b> ${escapeHtml(a.por_que)}</p>
        <p><b>Como corrigir:</b> ${escapeHtml(a.como_corrigir)}</p>
      </article>`).join('') || '<p class="bib-desc">Nenhum achado nesta severidade.</p>';
  }
  corpo.querySelectorAll('[data-sev]').forEach(b => b.addEventListener('click', () => {
    filtro = b.dataset.sev;
    corpo.querySelectorAll('[data-sev]').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
    desenhar();
  }));
  desenhar();
}

function rxMedidas(corpo, d) {
  corpo.innerHTML = `
    <div class="pn-barra"><input class="pn-busca" id="rxBusca" type="search" placeholder="Buscar medida ou DAX…" aria-label="Buscar medida"></div>
    <div class="rx-rolagem"><table class="rx-tabela"><thead><tr>
      <th>Medida</th><th>Tabela</th><th>Usa</th><th>Impacta</th><th>No relatório</th><th>Descrição</th>
    </tr></thead><tbody id="rxLinhas"></tbody></table></div>`;
  const linhas = corpo.querySelector('#rxLinhas');
  const busca = corpo.querySelector('#rxBusca');
  function desenhar() {
    const q = busca.value.trim().toLowerCase();
    linhas.innerHTML = d.medidas.filter(m => !q || (m.nome + ' ' + m.dax).toLowerCase().includes(q)).map(m => `
      <tr data-medida="${escapeHtml(m.nome)}">
        <td data-rotulo="Medida"><b>${escapeHtml(m.nome)}</b></td><td data-rotulo="Tabela">${escapeHtml(m.tabela)}</td>
        <td data-rotulo="Usa">${m.usa_medidas.length + m.usa_colunas.length}</td><td data-rotulo="Impacta">${m.impacta.length}</td>
        <td data-rotulo="No relatório">${m.usada_no_relatorio === null ? '—' : m.usada_no_relatorio ? 'sim' : '<b>não</b>'}</td>
        <td data-rotulo="Descrição">${escapeHtml(m.descricao || '—')}</td>
      </tr>`).join('');
    linhas.querySelectorAll('tr[data-medida]').forEach(tr => tr.addEventListener('click', () => {
      corpo.parentElement.querySelector('.rx-aba[data-aba="3"]').click();
      rxFocar(tr.dataset.medida);
    }));
  }
  busca.addEventListener('input', desenhar);
  desenhar();
}

function rxTabelas(corpo, d) {
  corpo.innerHTML = `<div class="rx-rolagem"><table class="rx-tabela"><thead><tr>
      <th>Tabela</th><th>Tipo</th><th>Colunas</th><th>Chave</th><th>Medidas</th><th>Descrição</th>
    </tr></thead><tbody>${d.tabelas.map(t => `
      <tr><td data-rotulo="Tabela"><b>${escapeHtml(t.nome)}</b>${t.oculta ? ' <span class="bib-origem">oculta</span>' : ''}</td>
        <td data-rotulo="Tipo">${escapeHtml(t.tipo)}</td><td data-rotulo="Colunas">${t.colunas.length}</td>
        <td data-rotulo="Chave">${escapeHtml(t.colunas.filter(c => c.chave).map(c => c.nome).join(', ') || '—')}</td>
        <td data-rotulo="Medidas">${t.medidas}</td><td data-rotulo="Descrição">${escapeHtml(t.descricao || '—')}</td></tr>`).join('')}
    </tbody></table></div>`;
}

let rxCy = null;
let rxDados = null;
function rxDependencias(corpo, d) {
  rxDados = d;
  rxCy = null;  // o grafo anterior foi descartado com o HTML; rxFocar espera o novo
  corpo.innerHTML = `
    <div class="rx-dep">
      <div class="grf-tela" id="rxTela" role="img" aria-label="Grafo de dependências das medidas"></div>
      <aside class="rx-painel" id="rxPainel"><h3>Dependências</h3><p>Clique numa medida para ver o DAX, o que ela usa e o que quebra se ela mudar. Medidas em cor, colunas em cinza.</p></aside>
    </div>`;
  grfBiblioteca().then(() => {
    const css = getComputedStyle(document.documentElement);
    const fg = css.getPropertyValue('--fg').trim();
    const borda = css.getPropertyValue('--border-strong').trim();
    rxCy = cytoscape({
      container: document.getElementById('rxTela'),
      elements: [
        ...d.dependencias.nos.map(n => ({ data: { ...n } })),
        ...d.dependencias.ligacoes.map(([a, b], i) => ({ data: { id: 'l' + i, source: a, target: b } })),
      ],
      style: [
        { selector: 'node', style: { label: 'data(rotulo)', color: fg, 'font-size': 10, 'text-valign': 'bottom', 'text-margin-y': 3,
          'text-outline-color': css.getPropertyValue('--card').trim(), 'text-outline-width': 2, 'min-zoomed-font-size': 6 } },
        { selector: 'node[tipo = "medida"]', style: { 'background-color': token('--c-modulo'), width: 18, height: 18 } },
        { selector: 'node[tipo = "coluna"]', style: { 'background-color': token('--c-material'), width: 9, height: 9, 'font-size': 8, 'min-zoomed-font-size': 9 } },
        { selector: 'edge', style: { width: 1, 'line-color': borda, 'target-arrow-color': borda, 'target-arrow-shape': 'triangle',
          'arrow-scale': .7, 'curve-style': 'bezier', opacity: .8 } },
        { selector: '.apagado', style: { opacity: .1 } },
        { selector: 'node.foco', style: { 'border-width': 3, 'border-color': fg } },
      ],
      layout: { name: 'cose', animate: false, nodeRepulsion: 7000, idealEdgeLength: 60 },
      wheelSensitivity: 0.25,
    });
    rxCy.on('tap', 'node[tipo = "medida"]', e => rxFocar(e.target.data('rotulo')));
    rxCy.on('tap', e => { if (e.target === rxCy) { rxCy.elements().removeClass('apagado foco'); } });
  }).catch(e => { corpo.innerHTML = `<p class="bib-desc">${escapeHtml(e.message)}</p>`; });
}

function rxFocar(nome) {
  const tentar = () => {
    if (!rxCy) return setTimeout(tentar, 150);
    const m = rxDados.medidas.find(x => x.nome === nome);
    const no = rxCy.getElementById('m:' + nome);
    rxCy.elements().removeClass('apagado foco');
    if (no.nonempty()) {
      const ligado = no.closedNeighborhood().union(no.predecessors()).union(no.successors());
      rxCy.elements().not(ligado).addClass('apagado');
      no.addClass('foco');
      rxCy.animate({ fit: { eles: ligado, padding: 50 }, duration: 300 });
    }
    const li = xs => xs.length ? `<ul class="rx-lista">${xs.map(x => `<li>${escapeHtml(x)}</li>`).join('')}</ul>` : '<p>—</p>';
    document.getElementById('rxPainel').innerHTML = `
      <h3>${escapeHtml(m.nome)}</h3>
      <p>${escapeHtml(m.tabela)}${m.formato ? ' · formato ' + escapeHtml(m.formato) : ''}${m.usada_no_relatorio === false ? ' · <b>não usada no relatório</b>' : ''}</p>
      ${m.descricao ? `<p>${escapeHtml(m.descricao)}</p>` : ''}
      <pre>${escapeHtml(m.dax)}</pre>
      <b>Usa medidas</b>${li(m.usa_medidas)}
      <b>Usa colunas</b>${li(m.usa_colunas)}
      <b>Impacta se mudar (${m.impacta.length})</b>${li(m.impacta)}`;
  };
  tentar();
}

// ========== TELA DO KIT VISUAL ==========
// Contraste pela luminância relativa da WCAG 2.1.
function kitLum(hex) {
  const c = hex.replace('#', '').match(/.{2}/g).map(v => parseInt(v, 16) / 255)
    .map(v => v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4));
  return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
}
function kitContraste(a, b) {
  const [x, y] = [kitLum(a), kitLum(b)].sort((p, q) => q - p);
  return (x + 0.05) / (y + 0.05);
}
function kitTextoSobre(fundo) { return kitContraste(fundo, '#FFFFFF') >= kitContraste(fundo, '#111111') ? '#FFFFFF' : '#111111'; }

function renderKit(file, text) {
