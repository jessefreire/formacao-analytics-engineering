.content h2 { font-size: clamp(1.125rem, 1rem + .8vw, 1.4rem); font-weight: 700; line-height: 1.3; margin: var(--sp-8) 0 var(--sp-3); letter-spacing: -.01em; }
.content h3 { font-size: var(--fs-ui); font-weight: 700; line-height: 1.4; margin: var(--sp-6) 0 var(--sp-2); color: var(--fg-soft); text-transform: uppercase; letter-spacing: .06em; }
