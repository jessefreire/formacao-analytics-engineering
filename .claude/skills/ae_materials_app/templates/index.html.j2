document.addEventListener('keydown', e => {
  const emControle = e.target?.closest?.('input,select,textarea,button,[contenteditable],[role=option],[role=tab]');
  if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); paletaAberta ? fecharPaleta() : abrirPaleta(); return; }
  if (e.key === 'Escape') {
    if (paletaAberta) { e.preventDefault(); fecharPaleta(); }
    else if (sidebarOpen) { e.preventDefault(); toggleSidebar(false); }
    return;
  }
  if (paletaAberta) return;
  if (e.key === '/' && !emControle && !e.ctrlKey && !e.metaKey) { e.preventDefault(); abrirPaleta(); return; }
  if (e.key.toLowerCase() === 'b' && e.ctrlKey && desktop.matches) { e.preventDefault(); toggleSidebarCollapse(); return; }
  // Setas só trocam de material se o foco não estiver num controle: sem isso o botão de
  // estado do desafio mudava o valor E saltava de página no mesmo evento.
  if (currentFile && !emControle && !sidebarOpen) {
    if (e.key === 'ArrowLeft') { e.preventDefault(); goPrev(); }
    if (e.key === 'ArrowRight') { e.preventDefault(); goNext(); }
  }
});

