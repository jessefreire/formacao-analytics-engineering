      <svg class="ico" aria-hidden="true"><use href="#i-search"/></svg>
      <input id="paletaInput" type="search" placeholder="Buscar por título, módulo ou arquivo…" autocomplete="off" spellcheck="false"
             role="combobox" aria-expanded="true" aria-controls="paletaLista" aria-autocomplete="list" aria-label="Buscar materiais">
