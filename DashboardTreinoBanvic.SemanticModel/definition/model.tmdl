model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dim_agencias","dim_clientes","dim_datas","fact_transacoes","PastaDados"]

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

ref table dim_agencias
ref table dim_clientes
ref table dim_datas
ref table fact_transacoes
ref table Medidas

ref cultureInfo pt-BR

